/* CMS Pipelines device driver tests */

TestSetup:
   /* Ensure WITHSTEM is available. */
   Call NoError 'NUCEXT WITHSTEM'
   If RC <> 0 then 'NUCXTEXT WITHSTEM (SYSTEM'

   /* Don't let the test leave anything in the stack. */
   Call NoError 'MAKEBUF'

   /* Reset PLUNGER to clean state. */
   Call NoError 'NUCEXT PLUNGER'
   If RC = 0 then Call NoError 'NUCXDROP PLUNGER'
   'PLUNGER ENABLE'
   'PIPE literal x|hole'
   Return

TestTeardown:
   /* Don't let the test leave anything in the stack. */
   'DROPBUF'

   /* Reset to clean state. */
   Call NoError 'NUCXDROP WITHSTEM'
   Call NoError 'NUCEXT PLUNGER'
   If RC = 0 then Call NoError 'NUCXDROP PLUNGER'
   Return

TestBeat:
   Ref.0 = 4
   Ref.1 = 'beat 4'
   Ref.2 = 'beat 4'
   Ref.3 = 'beat 4'
   Ref.4 = 'delay +15'
   'PIPE (end ?) literal +15| delay | change //delay / | a: beat 4 /beat 4/ | b: faninany | stem Out. ? a: | b:'
   Call AssertStemIdentical 'Ref.', 'Out.'
   Return

TestCommand:
   Parse upper source . . MyFn MyFt .
   'PIPE command LISTFILE' MyFn MyFt '| stem Out.'
   Call AssertStartsWith Left(MyFn,8) Left(MyFt,8) 'A', Value('Out.1')
   Call AssertEqual 1, Out.0
   Return

TestConsoleInput:
   Msg.0 = 2
   Msg.1 = 'Now is the winter of our discontent'
   Msg.2 = 'made glorious summer by this sun of York'
   Push ''
   Push Msg.2
   Push Msg.1
   'PIPE console | stem Out.'
   Call AssertStemIdentical 'Msg.', 'Out.'
   Return

TestConsoleOutput:
   Msg.0 = 2
   Msg.1 = 'Now is the winter of our discontent'
   Msg.2 = 'made glorious summer by this sun of York'
   'WITHSTEM OUTPUT Out. COMMAND PIPE literal' Msg.2 ||'| literal' Msg.1 || '|console'
   Call AssertStemIdentical 'Msg.', 'Out.'
   Return

TestCms:
   Parse upper source . . MyFn MyFt .
   'PIPE cms listfile' MyFn MyFt '| stem Out.'
   Call AssertStartsWith Left(MyFn,8) Left(MyFt,8) 'A', Value('Out.1')
   Call AssertEqual 1, Out.0
   Return

TestCp:
   'EXECIO * CP ( STEM Ref. STRING Q V CONS'
   'PIPE CP QUERY V CONS | stem Out.'
   Call AssertStemIdentical 'Ref.', 'Out.'
   Return

TestDelay:
   Ref.0 = 1
   Ref.1 = '...+15 '
   'PIPE literal +15 | delay | change //.../ | stem Out.'
   Call AssertStemIdentical 'Ref.', 'Out.'
   Return

TestDiskFastRead:
   Driver = 'diskfast'
   Signal DoDiskRead

TestDiskSlowRead:
   Driver = 'diskslow'
   Signal DoDiskRead

TestMDiskFastRead:
   Driver = 'mdskfast'
   Signal DoDiskRead

TestMDiskSlowRead:
   Driver = 'mdskslow'
   Signal DoDiskRead

TestNoseMDiskRead:
   Driver = '<mdsk'
   Signal DoDiskRead

TestNoseRead:
   Driver = '<'
   Signal DoDiskRead

DoDiskRead:
   Parse source . . MyFn .
   MySize = SourceLine()
   'PIPE' Driver MyFn 'EXEC A |stem Out.'
   Call AssertEqual MySize, Out.0
   Do I = 1 to Out.0
      Source = SourceLine(I)
      /* CMS files can't have empty records, so REXXUNIT pads them to " " */
      If Source == '' then Source = ' '
      Call AssertIdentical Source, Out.I, 'Source line #' || I
   End
   Return

TestDiskReadBack:
   Driver = 'diskback'
   Signal DoDiskReadBack

TestMDiskReadBack:
   Driver = 'mdskback'
   Signal DoDiskReadBack

DoDiskReadBack:
   Parse source . . MyFn .
   MySize = SourceLine()
   'PIPE' Driver MyFn 'EXEC A |stem Out.'
   Call AssertEqual MySize, Out.0
   Do I = 1 to Out.0
      J = (Out.0 - I) + 1
      Source = SourceLine(J)
      /* CMS files can't have empty records, so REXXUNIT pads them to " " */
      If Source == '' then Source = ' '
      Call AssertIdentical Source, Out.I, 'Source line #' || J
   End
   Return

TestDiskReadRandom:
   Driver = 'diskrandom'
   Signal DoDiskReadRandom

TestMDiskReadRandom:
   Driver = 'mdskrandom'
   Signal DoDiskReadRandom

DoDiskReadRandom:
   Parse source . . MyFn .
   MySize = SourceLine()
   Ref. = ''
   Ref.0 = Random(1, 20)
   RecordList = ''
   Do I = 1 to Ref.0
      RecNum = Random(1, MySize)
      RecordList = RecordList RecNum
      Source = SourceLine(RecNum)
      /* CMS files can't have empty records, so REXXUNIT pads them to " " */
      If Source == '' then Source = ' '
      Ref.I = Source
   End
   'PIPE literal' RecordList '|' Driver MyFn 'EXEC A | stem Out.'
   Call AssertStemIdentical 'Ref.', 'Out.'
   Return

TestDiskUpdate:
   Driver = 'diskupdate'
   Signal DoDiskUpdate

TestMDiskUpdate:
   Driver = 'mdskupdate'
   Signal DoDiskUpdate

DoDiskUpdate:
   OutFile = 'TDU CMSUT1 A'
   Call Erase OutFile
   In.0 = 3
   In.1 = 'Alas, poor Yorik.  I knew him, Laertes.'
   In.2 = 'Now is the winter of our discontent'
   In.3 = 'Made glorious summer by this son of York'
   'EXECIO' In.0 'DISKW' OutFile '(FINIS STEM IN.'
   'PIPE literal 1         Alas, poor Yorik.  I knew him, Horatio.|' Driver OutFile
   'EXECIO * DISKR' OutFile '(STEM OUT.'
   Call Erase OutFile
   In.1 = ChangeStr('Laertes', In.1, 'Horatio')
   Call AssertStemIdentical 'In.', 'Out.'
   Return

TestNoseWriteAppend:
   Driver = '>>'
   Signal DoDiskWriteAppend

TestNoseMDiskWriteAppend:
   Driver = '>>mdsk'
   Signal DoDiskWriteAppend

DoDiskWriteAppend:
   OutFile = 'TDWA CMSUT1 A'
   Call Erase OutFile
   Line1 = 'Alas, poor Yorik.'
   'EXECIO 1 DISKW' OutFile '(FINIS STRING' Line1
   In.0 = 2
   In.1 = 'Now is the winter of our discontent'
   In.2 = 'Made glorious summer by this son of York'
   'PIPE stem In. |' Driver OutFile
   'EXECIO * DISKR' OutFile '(STEM OUT.'
   Call Erase OutFile
   Call AssertEqual In.0 + 1, Out.0
   Call AssertIdentical '1:' Line1, '1:' Out.1
   Do I = 1 to In.0
      J = I + 1
      Call AssertIdentical J':' In.I, J':' Out.J
   End
   Return

TestNoseMDiskWriteNew:
   Driver = '>mdsk'
   Signal DoDiskWriteNew

TestNoseWriteNew:
   Driver = '>'
   Signal DoDiskWriteNew

DoDiskWriteNew:
   OutFile = 'TDWN CMSUT1 A'
   Call Erase OutFile
   In.0 = 2
   In.1 = 'Now is the winter of our discontent'
   In.2 = 'Made glorious summer by this son of York'
   'PIPE stem In. |' Driver OutFile
   'EXECIO * DISKR' OutFile '(STEM OUT.'
   Call Erase OutFile
   Call AssertStemIdentical 'In.', 'Out.'
   Return

TestNoseMDiskWriteReplace:
   Driver = '>mdsk'
   Signal DoDiskWriteReplace

TestNoseWriteReplace:
   Driver = '>'
   Signal DoDiskWriteReplace

DoDiskWriteReplace:
   OutFile = 'TDWR CMSUT1 A'
   'EXECIO 1 DISKW' OutFile '(FINIS STRING Output from EXECIO'
   In.0 = 2
   In.1 = 'Now is the winter of our discontent'
   In.2 = 'Made glorious summer by this son of York'
   'PIPE stem In. |' Driver OutFile
   'EXECIO * DISKR' OutFile '(STEM OUT.'
   Call Erase OutFile
   Call AssertStemIdentical 'In.', 'Out.'
   Return

TestEmsgCode:
   Msg = 'ABCDEF001I This is only a test.'
   OldEMsg = SaveSetEmsg()
   'SET EMSG CODE'
   'WITHSTEM OUTPUT O. COMMAND PIPE literal' Msg || '| emsg'
   'SET EMSG' OldEMsg
   Call AssertEqual 1, O.0
   Call AssertIdentical Msg, O.1
   Return

TestEmsgText:
   Msg = 'ABCDEF001I This is only a test.'
   OldEMsg = SaveSetEmsg()
   'SET EMSG TEXT'
   'WITHSTEM OUTPUT O. COMMAND PIPE literal' Msg || '| emsg'
   'SET EMSG' OldEMsg
   Call AssertEqual 1, O.0
   Call AssertIdentical Msg, O.1
   Return

TestEmsgOff:
   Msg = 'ABCDEF001I This is only a test.'
   OldEMsg = SaveSetEmsg()
   'SET EMSG OFF'
   'WITHSTEM OUTPUT O. COMMAND PIPE literal' Msg || '| emsg'
   'SET EMSG' OldEMsg
   Call AssertEqual 1, O.0
   Call AssertIdentical Msg, O.1
   Return

TestEmsgOn:
   Msg = 'ABCDEF001I This is only a test.'
   OldEMsg = SaveSetEmsg()
   'SET EMSG ON'
   'WITHSTEM OUTPUT O. COMMAND PIPE literal' Msg || '| emsg'
   'SET EMSG' OldEMsg
   Call AssertEqual 1, O.0
   Call AssertIdentical Msg, O.1
   Return

TestListpds:
   MemberNames = 'FSREAD FSWRITE'
   'PIPE listpds cmslib maclib s | stem out.'
   Call AssertNotEqual 0, Out.0
   Found = 0
   Do I = 1 to Out.0
      Parse var Out.I Member .
      If WordPos(Member, MemberNames) > 0 then Found = Found + 1
   End
   Call AssertEqual Words(MemberNames), Found
   Return

TestMembers:
   MacroNames = 'fsread fswrite'
   'PIPE members cmslib maclib s' MacroNames '| stem out.'
   Call AssertNotEqual 0, Out.0
   J = 0
   Do I = 1 to Words(MacroNames)
      MacroName = Translate(Word(MacroNames, I))
      J = J + 1
      Call AssertTrue J <= Out.0
      Call AssertEqual 'MACRO', Word(Out.J, 1)
      J = J + 1
      Call AssertTrue J <= Out.0
      Call AssertEqual MacroName, Word(Out.J, 2)
      Do J = J to Out.0 while Out.J <> ''
         /* Skip macro contents */
      End
   End
   Call AssertEqual Out.0, J
   Return

TestNucext:
   Call Erase 'TNX * A'
   I=0
   I=I+1; A.I = "TNX      CSECT"
   I=I+1; A.I = "         USING *,12"
   I=I+1; A.I = "         LR    11,14"
   I=I+1; A.I = "         LA    1,MESSAGE"
   I=I+1; A.I = "         STCM  1,B'0111',PLIST+8+1"
   I=I+1; A.I = "*        WRTERM 'Hi from TestNucext!'"
   I=I+1; A.I = "         CNOP  0,4"
   I=I+1; A.I = "         BAL   1,DOIT"
   I=I+1; A.I = "PLIST    DC    CL8'TYPLIN'"
   I=I+1; A.I = "         DC    X'01',AL3(*-*)"
   I=I+1; A.I = "         DC    C'B',X'00',AL2(L'MESSAGE)"
   I=I+1; A.I = "DOIT     SVC   202"
   I=I+1; A.I = "         DC    AL4(1)"
   I=I+1; A.I = "         BR    11"
   I=I+1; A.I = "MESSAGE  DC    C'Hi from TestNucext!'"
   I=I+1; A.I = "         END"
   A.0 = I
   Call Assemble 'A.', 'TNX'
   'NUCXTEXT TNX'
   'PIPE nucext tNx'
   Say 'Expected "Hi from TestNucext!", hope you got it.'
   Call NoError 'NUCXDROP TNX'
   Call Erase 'TNX * A'
   Return

TestPdsdirect:
   'PIPE pdsdirect dmmmac maclib s | stem Out.'
   Call AssertEqual 3, Out.0
   Call AssertIdentical "DMSLIB", Left(Out.1, 6)
   Call AssertIdentical "MSGP    ", Left(Out.2, 8)
   Call AssertIdentical "DMMMAC", Left(Out.3, 6)
   Return

TestPrintMC:
   Driver = 'printmc'
   Signal DoPrint

TestURO:
   Driver = 'uro'
   Signal DoPrint

DoPrint:
   OutFile = 'TURO DATA A'
   Call Erase OutFile
   In.0 = 3
   In.1 = '1Alas, poor Yorik.  I knew him, Horatio.'
   In.2 = '+Now is the winter of our discontent'
   In.3 = '0Made glorious summer by this son of York'
   'CP SPOOL PRINTER TO * CLASS Q'
   'CP DISCARD PURGE READER CLASS Q'
   'PIPE stem In. | asatomc |' driver
   'CP CLOSE PRINTER'
   'CP SPOOL READER CLASS Q'
   'PIPE reader | mctoasa | stem Out.'
   Call Erase OutFile
   Call AssertStemIdentical 'In.', 'Out.'
   Return

TestPunch:
   OutFile = 'TP DATA A'
   Call Erase OutFile
   In.0 = 3
   In.1 = Left('Alas, poor Yorik.  I knew him, Horatio.', 80)
   In.2 = Left('Now is the winter of our discontent', 80)
   In.3 = Left('Made glorious summer by this son of York', 80)
   'CP SPOOL PUNCH TO * CLASS Q'
   'CP DISCARD PURGE PUNCH CLASS Q'
   'PIPE stem In. | punch'
   'CP CLOSE PUNCH'
   'CP SPOOL READER CLASS Q'
   'READCARD' OutFile
   'EXECIO * DISKR' OutFile '(FINIS STEM OUT.'
   Call Erase OutFile
   Call AssertStemIdentical 'In.', 'Out.'
   Return

TestReader:
   OutFile = 'TR DATA A'
   Call Erase OutFile
   In.0 = 3
   In.1 = Left('Alas, poor Yorik.  I knew him, Horatio.', 80)
   In.2 = Left('Now is the winter of our discontent', 80)
   In.3 = Left('Made glorious summer by this son of York', 80)
   'CP SPOOL PUNCH TO * CLASS Q'
   'CP DISCARD PURGE READER CLASS Q'
   'EXECIO' In.0 'PUNCH (STEM IN.'
   'CP CLOSE PUNCH'
   'CP SPOOL READER CLASS Q'
   'PIPE reader | strfind x41 | spec 2-* 1.80 | stem Out.'
   Call Erase OutFile
   Call AssertStemIdentical 'In.', 'Out.'
   Return

TestRexxDisk:
   Lines.1 = '/* */'
   Lines.2 = '"OUTPUT Hi from Rexx!"'
   Lines.3 = 'Exit'
   Lines.0 = 3
   'EXECIO' Lines.0 'DISKW TRD REXX A (FINIS STEM Lines.'
   'PIPE rexx TRD | stem Out.'
   'ERASE TRD REXX A'
   Ref.1 = 'Hi from Rexx!'
   Ref.0 = 1
   Call AssertStemIdentical 'Ref.', 'Out.'
   Return

TestRexxStorage:
   Lines.1 = '/* */'
   Lines.2 = '"OUTPUT Hi from Rexx in storage!"'
   Lines.3 = 'Exit'
   Lines.0 = 3
   'EXECIO' Lines.0 'DISKW TRD REXX A (FINIS STEM Lines.'
   'EXECLOAD TRD REXX'
   'ERASE TRD REXX A'
   'PIPE rexx TRD | stem Out.'
   Ref.1 = 'Hi from Rexx in storage!'
   Ref.0 = 1
   Call AssertStemIdentical 'Ref.', 'Out.'
   Return

TestRexxStreamPrimary:
   'PIPE' ,
      'literal' ,
         '/* */' ,
         '"OUTPUT Hi from Rexx in the primary stream!";' ,
         'Exit' ,
      '|rexx *:' ,
      '|stem Out.'
   Ref.1 = 'Hi from Rexx in the primary stream!'
   Ref.0 = 1
   Call AssertStemIdentical 'Ref.', 'Out.'
   Return

TestRexxStreamSecondary:
   'PIPE (end ?)' ,
      'R: rexx *.1:' ,
      '|stem Out.' ,
      '?literal' ,
         '/* */' ,
         '"OUTPUT Hi from Rexx in the secondary stream!";' ,
         'Exit' ,
      '|R:'
   Ref.1 = 'Hi from Rexx in the secondary stream!'
   Ref.0 = 1
   Call AssertStemIdentical 'Ref.', 'Out.'
   Return

TestStackInput:
   Msg.0 = 2
   Msg.1 = 'Now is the winter of our discontent'
   Msg.2 = 'made glorious summer by this sun of York'
   Push Msg.2
   Push Msg.1
   'PIPE stack | stem Out.'
   Call AssertStemIdentical 'Msg.', 'Out.'
   Return

TestStackOutput:
   Msg1 = 'Now is the winter of our discontent'
   Msg2 = 'made glorious summer by this sun of York'
   'PIPE literal' Msg2 ||'| literal' Msg1 || '|stack fifo'
   Count = NoError('SENTRIES')
   Call AssertEqual 2, Count
   Parse pull Out1
   Parse pull Out2
   Call AssertIdentical Msg1, Out1
   Call AssertIdentical Msg2, Out2
   Return

TestState:
   Call Erase 'TS DATA A'
   'EXECIO 1 DISKW TS DATA A (FINIS STRING blah blah blah'
   'LISTFILE TS DATA A (NOHEADER LIFO ALLOC'
   Parse pull Ref
   'PIPE state ts data a | stem Out.'
   Call Erase 'TS DATA A'
   Call AssertEqual 1, Out.0
   /* Don't check the date and time, because LISTFILE and PIPE STATE format
      them differently.
   */
   Call AssertEqual Space(Ref), Space(SubWord(Out.1, 1, Words(Out.1)-2))
   Return

TestStateW:
   Call Erase 'TSW DATA A'
   'EXECIO 1 DISKW TSW DATA A (FINIS STRING blah blah blah'
   'LISTFILE TSW DATA A (NOHEADER LIFO ALLOC'
   Parse pull Ref
   'PIPE state tsw data a | stem Out.'
   Call Erase 'TSW DATA A'
   Call AssertEqual 1, Out.0
   /* Don't check the date and time, because LISTFILE and PIPE STATE format
      them differently.
   */
   Call AssertEqual Space(Ref), Space(SubWord(Out.1, 1, Words(Out.1)-2))
   Return

TestStem:
   'PIPE literal Hello stem1!|literal Hello stem2!|stem Out.'
   Call AssertEqual 2, Out.0
   Call AssertIdentical 'Hello stem2!', Out.1
   Call AssertIdentical 'Hello stem1!', Out.2
   Return

TestStorageReadExplicit:
   SysId = Storage('200', 32)
   'PIPE storage read 200 32 | var Out'
   Call AssertIdentical SysId, Out
   Return

TestStorageReadImplied:
   SysId = Storage('200', 32)
   'PIPE storage 200 32 | var Out'
   Call AssertIdentical SysId, Out
   Return

TestStorageWrite:
   Before = Storage('20000', 10)
   'PIPE literal Hello CMS!|storage 20000 10 E0'
   After = Storage('20000', 10)
   Call AssertNotEqual Before, After
   Call AssertIdentical 'Hello CMS!', After
   Return

TestStrliteral:
   'WITHSTEM OUTPUT O. COMMAND PIPE strliteral /  Hello  cruel  world!  / | console'
   Call AssertEqual 1, O.0
   Call AssertIdentical '  Hello  cruel  world!  ', O.1
   Return

TestSubcom:
   'WITHSTEM OUTPUT O. COMMAND PIPE subcom CMS q cmstype | stem Q.'
   Call AssertEqual 0, Q.0
   Call AssertEqual 1, O.0
   Call AssertIdentical 'CMSTYPE  = RT', O.1
   Return

TestVar:
   'PIPE literal some text | var X'
   Call AssertIdentical 'some text ', X
   Return

TestVarDrop:
   x = 'Once upon a time, in the Black Forest, a little tin soldier stood.'
   'PIPE literal X | vardrop'
   Call AssertEqual 'LIT', Symbol('X')
   Return

TestVarFetch:
   In = 'Once upon a time, in the Black Forest, a little tin soldier stood.'
   'PIPE literal IN| varfetch | var OUT'
   Call AssertIdentical In, Out
   Return

TestVarload:
   'PIPE literal /VAR1/var1 text|literal /VAR2/var2 text| varload'
   Call AssertIdentical 'var1 text', var1
   Call AssertIdentical 'var2 text', var2
   Return

TestVarSet:
   'PIPE literal /VAR1/var1 text|literal /VAR2/var2 text| varset'
   Call AssertIdentical 'var1 text', var1
   Call AssertIdentical 'var2 text', var2
   Return

TestXrange:
   'PIPE xrange 00-ff | var OUT'
   Call AssertIdentical XRange('00'x, 'ff'x), Out
   Return

Assemble:
trace o
   Parse arg CodeStem . , FN .
   Do I = 0 to Value(CodeStem || '0')
      Line.I = Left(Value(CodeStem || I), 80)
   End
   'EXECIO' Line.0 'DISKW' FN 'ASSEMBLE A 1 F 80 ( FINIS STEM Line.'
   Call NoError 'WITHSTEM OUTPUT SYSTERM. COMMAND ASSEMBLE' FN '( DISK'
   If RC <> 0 then Do I = 1 to SysTerm.0
      Say SysTerm.I
   End
   Return

Erase: Procedure expose $RXU.
   'SET CMSTYPE HT'
   Call NoError 'ERASE' Arg(1)
   'SET CMSTYPE RT'
   Return

SaveSetEmsg: Procedure expose $RXU.
   Call NoError 'MAKEBUF'
   'CP FIFO QUERY SET'
   Pull 'EMSG' OldEMsg ','
   Call NoError 'DROPBUF'
   Return OldEMsg
