         MACRO ,
&LABEL   $ZAP  &TYPE,&OFFSETX,&DATA,&IF=,&RELOC=NONE
.*
.*     $ZAP BEGIN - start a ZAP
.*     $ZAP END - end a ZAP
.*     $ZAP REP,offset,data,[,RELOC=...] - alter data
.*     $ZAP SKIP,IF=(byte,bit,ON|OFF) - skip a ZAP
.*     $ZAP STOP - end of all ZAPs
.*     $ZAP VER,offset,data[,RELOC=...] - verify data
.*
.*  &RELOC: Data is relocated ...
.*     NONE - no relcation
.*     PIPMOD - relative to PIPMOD
.*     PLUNGER - relative to PLUNGER (REP only)
.*     OFFSET - relative to target location (REP only)
.*
         LCLC  &DATALBL,&ONOFF,&TCODE
&DATALBL SETC  'Z&SYSNDX.D'
         AIF   ('&TYPE' EQ 'REP').REP1
         AIF   ('&TYPE' EQ 'VER').VER1
.* All the others have no DATA, OFFSETX, or RELOC
&TCODE   SETC  'ZAPTSKP'
         AIF   ('&TYPE' EQ 'SKIP').SKP1
.* All the others have no IF
         AIF   ('&IF' NE '').IBAD1
         AIF   ('&DATA' NE '').DBAD
         AIF   ('&OFFSETX' NE '').OBAD
         AIF   ('&RELOC' NE 'NONE').RBAD
&TCODE   SETC  'ZAPTBEG'
         AIF   ('&TYPE' EQ 'BEGIN').BEG1
&TCODE   SETC  'ZAPTEND'
         AIF   ('&TYPE' EQ 'END').NODATA
&TCODE   SETC  'ZAPTSTP'
         AIF   ('&TYPE' EQ 'STOP').NODATA
         AGO   .TBAD
.BEG1    ANOP  ,
         AIF   ('&LABEL' EQ '').LBAD
         AGO   .DATAB
.SKP1    ANOP  ,
         AIF   ('&IF'(1,1) NE '(').IBAD2
         AIF   (N'&IF NE 3).IBAD2
         AIF   ('&IF(1)'(1,3) NE 'PRM').IBAD2
         AIF   ('&IF(2)'(1,3) NE 'PRM').IBAD2
&ONOFF   SETC  '0'
         AIF   ('&IF(3)' EQ 'OFF').SKP2
&ONOFF   SETC  '&IF(2)'
         AIF   ('&IF(3)' EQ 'ON').SKP2
         AGO   .IBAD2
.SKP2    ANOP  ,
         AGO   .DATAS
.VER1    ANOP  ,
         AIF   ('&IF' NE '').IBAD1
&TCODE   SETC  'ZAPTVERN'
         AIF   ('&RELOC' EQ 'NONE').DATAN
.*&TCODE   SETC  'ZAPTVERO'
.*         AIF   ('&RELOC' EQ 'OFFSET').DATAO
.*&TCODE   SETC  'ZAPTVERR'
.*         AIF   ('&RELOC' EQ 'PLUNGER').DATAR
         AIF   (K'&DATA NE 8).DBAD
&TCODE   SETC  'ZAPTVERJ'
         AIF   ('&RELOC' EQ 'PIPMOD').DATAJ
         AGO   .RBAD
.REP1    ANOP  ,
         AIF   ('&IF' NE '').IBAD1
&TCODE   SETC  'ZAPTREPN'
         AIF   ('&RELOC' EQ 'NONE').DATAN
&TCODE   SETC  'ZAPTREPO'
         AIF   ('&RELOC' EQ 'OFFSET').DATAO
&TCODE   SETC  'ZAPTREPR'
         AIF   ('&RELOC' EQ 'PLUNGER').DATAR
         AIF   (K'&DATA NE 8).DBAD
&TCODE   SETC  'ZAPTREPJ'
         AIF   ('&RELOC' EQ 'PIPMOD').DATAJ
         AGO   .RBAD
.NODATA  ANOP  ,
&LABEL   DC    AL4(0),AL1(&TCODE),AL1(0)
         MEXIT ,
.DATAB   ANOP  ,
&LABEL   DC    AL4(0),AL1(&TCODE),AL1(8-1)
&DATALBL DC    CL8'&LABEL'
         MEXIT ,
.DATAJ   ANOP  ,
&LABEL   DC    AL4(X'&OFFSETX'),AL1(&TCODE),AL1(4-1)
&DATALBL DC    XL4'&DATA'
         MEXIT ,
.DATAN   ANOP  ,
&LABEL   DC    AL4(X'&OFFSETX'),AL1(&TCODE),AL1(L'&DATALBL-1)
&DATALBL DC    X'&DATA'
         MEXIT ,
.DATAO   ANOP  ,
&LABEL   DC    AL4(X'&OFFSETX'),AL1(&TCODE),AL1(4-1)
&DATALBL DC    AL4(&DATA)
         MEXIT ,
.DATAR   ANOP  ,
&LABEL   DC    AL4(X'&OFFSETX'),AL1(&TCODE),AL1(4-1)
&DATALBL DC    AL4(&DATA)
         MEXIT ,
.DATAS   ANOP  ,
         DC    AL4(0),AL1(&TCODE),AL1(6-1)
&DATALBL DC    AL4(&IF(1)-PRMSECT),AL1(&IF(2)),AL1(&ONOFF)
         MEXIT ,
.DBAD    ANOP  ,
         MNOTE 8,'"&DATA" is invalid for &TYPE.'
         MEXIT ,
.IBAD1   ANOP  ,
         MNOTE 8,'"&IF=" is invalid for &TYPE.'
         MEXIT ,
.IBAD2   ANOP  ,
         MNOTE 8,'"&IF=&IF" is invalid.'
         MEXIT ,
.LBAD    ANOP  ,
         MNOTE 8,'&TYPE requires a label.'
         MEXIT ,
.OBAD    ANOP  ,
         MNOTE 8,'"&OFFSETX" is invalid for &TYPE.'
         MEXIT ,
.RBAD    ANOP  ,
         MNOTE 8,'RELOC=&RELOC is invalid for &TYPE.'
         MEXIT ,
.TBAD    ANOP  ,
         MNOTE 8,'"&TYPE" is invalid.'
         MEXIT ,
         MEND  ,
