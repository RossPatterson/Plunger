         MACRO ,
&LABEL   $ENTER &DATALEN=0
         LCLC  &N
&N       SETC  '&SYSNDX'
&LABEL   DS    0H
         STM   R14,R12,12(R13)  Save caller's regs.
         LR    R11,R15        Set up routine basereg.
         USING &LABEL,R11
         LR    R12,R11        Set up
         S     R12,=A(&LABEL-&SYSECT)  common basereg.
         USING &SYSECT,R12
         LA    R3,WRKLEN+&DATALEN+7  Get workarea length
         SRL   R3,3              in doublewords.
         LR    R0,R3          Get
*        DMSFREE DWORDS=(0)      workarea.
         DMSFREE DWORDS=(0)
         LTR   R15,R15        OK?
         BNZ   ENT&N.A        No, error.
         ST    R13,4(,R1)     Save caller's SA pointer.
         LR    R13,R1         Point to ours.
         USING WRKSECT,R13
         ST    R3,WRKLEND     Save its size.
         L     R1,4(,R13)     Reload caller's regs.
         LM    R14,R10,12(R1)    except R11-R13.
         B     ENT&N.B        All done with setup.
         SPACE 3
ENT&N.A  DS    0H
         BAL   R14,MSG002     "Cannot obtain workarea"
         L     R14,12(,R13)   Restore all
         LM    R0,R12,20(R13)    all but R15.
         BR    R14            Return to caller.
         SPACE 3
ENT&N.B  DS    0H
         MEND  ,