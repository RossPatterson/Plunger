FNC      TITLE 'Configuration.'
         COPY  PLUCONFG
         ENTRY PLUFNCLD
         ENTRY PLUFNCUN
PLUFNC   CSECT ,
         TITLE 'PLUFNCLD - Load the functions.'
         PUSH  USING
         USING NUCON,0
PLUFNCLD $ENTER ,
         L     R10,NUCPLUPT
         USING PRMSECT,R10
         LA    R3,FUNCTBL     Get address and
         LA    R4,FUNCCNT        count of func list.
         SPACE 3
LOADLOOP DS    0H
         USING FUNCENT,R3
         L     R5,FUNCEP      Get entry
         AR    R5,R12            point.
         XC    WRKPLSTS,WRKPLSTS  Clear out plist.
         NUCEXT SET,NAME=FUNCNAME,                                     *
               ENTRY=(R5),                                             *
               INTTYPE=NONE,                                           *
               KEY=NUCLEUS,                                            *
               ORIGIN=((R12),0),                                       *
               PERM=YES,                                               *
               SERVICE=NO,                                             *
               SYSTEM=YES,                                             *
               MF=(E,WRKNXSPL),                                        *
               ERROR=1
         LTR   R15,R15        OK?
         BNZ   LOADERIN       Error, exit.
         SPACE 3
         LA    R3,FUNCLEN(,R3) Go do
         BCT   R4,LOADLOOP       next one.
         DROP  R3
         SPACE 3
         MVC   PRMSVCNP,SVCNPSW  Save CMS's SVC-new PSW.
         L     R0,=A(SVCHND-PLUFNC)  Take over
         AR    R0,R12            with our
         STCM  R0,B'0111',SVCNPSW+5  handler.
         SPACE 3
         MVC   PRMPGMNP,PGMNPSW  Save CMS's PGM-new PSW.
         L     R0,=A(PGMHND-PLUFNC)  Take over
         AR    R0,R12            with our
         STCM  R0,B'0111',PGMNPSW+5  handler.
         LA    R0,ABNXRES     Take over
         ST    R0,ADMSABXR       with ours.
         SPACE 3
LOADEXOK DS    0H
         SR    R15,R15
LOADEXIT $EXIT ,
         SPACE 3
LOADERIN BAL   R14,MSG019     "Error <rc> from NUCEXT SET <name>"
         B     LOADEXIT       Exit.
         TITLE 'PLUFNXUN - Unload functions.'
         PUSH  USING
         USING NUCON,0
PLUFNCUN $ENTER ,
         ICM   R10,B'1111',NUCPLUPT
         BZ    UNLDNPSW
         USING PRMSECT,R10
         MVC   SVCNPSW,PRMSVCNP  Restore CMS's SVC-new PSW.
         MVC   PGMNPSW,PRMPGMNP  Restore CMS's PGM-new PSW.
UNLDNPSW DS    0H
         SPACE 3
         LA    R3,FUNCTBL     Get address and
         LA    R4,FUNCCNT        count of func list.
         USING FUNCENT,R3
UNLDLOOP DS    0H
         XC    WRKPLSTS,WRKPLSTS  Clear out plist.
         NUCEXT CLR,NAME=FUNCNAME,MF=(E,WRKNXCPL),ERROR=1
         LTR   R15,R15        OK?
         BNZ   UNLDERDR       Error, exit.
         LA    R3,FUNCLEN(,R3) Go do
         BCT   R4,UNLDLOOP       next one.
         DROP  R3
         SPACE 3
UNLDEXOK DS    0H
         SR    R15,R15
UNLDEXIT $EXIT ,
         SPACE 3
UNLDERDR BAL   R14,MSG020     "Error <rc> from NUCEXT CLR <name>"
         B     UNLDEXIT       Exit.
         TITLE 'Messages.'
MSG002   DS    0H             No WRKSECT on this one, so no MF=E.
         LINEDIT TEXT='PLUFNC002E Cannot obtain workarea',DISP=ERRMSG
         LA    R15,2
         BR    R14
         SPACE 3
MSG019   DS    0H
         LR    R2,R15
         LINEDIT TEXT='PLUFNC019E Error ........ from NUCEXT SET ......*
               ..',                                                    *
               SUB=(DEC,(R2),CHARA,(R3)),                              *
               DISP=ERRMSG,                                            *
               MF=(E,WRKLEDPL)
         LA    R15,19
         BR    R14
         SPACE 3
MSG020   DS    0H
         LR    R2,R15
         LINEDIT TEXT='PLUFNC020E Error ........ from NUCEXT CLR ......*
               ..',                                                    *
               SUB=(DEC,(R2),CHARA,(R3)),                              *
               DISP=ERRMSG,                                            *
               MF=(E,WRKLEDPL)
         LA    R15,20
         BR    R14
         SPACE 3
MSG021   DS    0H
         LR    R3,R0
         LINEDIT TEXT='PLUFNC021E Record number ........ is too large',*
               SUB=(DEC,(R3)),                                         *
               DISP=ERRMSG,                                            *
               MF=(E,WRKLEDPL)
         LA    R15,21
         BR    R14
         SPACE 3
MSG022   DS    0H
         LR    R3,R0
         LINEDIT TEXT='PLUFNC022E Record count ........ is too large', *
               SUB=(DEC,(R3)),                                         *
               DISP=ERRMSG,                                            *
               MF=(E,WRKLEDPL)
         LA    R15,22
         BR    R14
         LTORG ,
         POP   USING
         TITLE 'CMS functions to take control of.'
FUNCTBL  DS    0D
         $FUNC ABNEXIT
FUNCLEN  EQU   *-FUNCTBL
         $FUNC DMSFNSMC       Another name for FINIS.
         $FUNC EPOINT
         $FUNC ESTATE
         $FUNC ESTATEW
         $FUNC GLOBALV
         $FUNC LINERD
*        $FUNC PGMHND         Only called via PGMNPSW.
*        $FUNC SVCHND         Only called via SVCNPSW.
         $FUNC RDBUF
         $FUNC WAITRD
         $FUNC WRBUF
FUNCCNT  EQU   (*-FUNCTBL)/FUNCLEN
         TITLE 'ABNEXIT - Set/clear ABEND handler.'
         PUSH  USING
         USING NUCON,0
ABNEXIT  $ENTER ,
         LR    R3,R1          Tokenized PLIST.
         CLC   =CL8'CLR',8(R3)  Clear?
         BE    ABNXCLR        Yes, do it.
         CLC   =CL8'SET',8(R3)  Set?
         BE    ABNXSET        Yes, do it.
*        RESET isn't invoked by SVC.
         LA    R15,1
         B     ABNXEXIT
         SPACE 3
ABNXEXOK DS    0H
         SR    R15,R15
ABNXEXIT $EXIT ,
         SPACE 3
ABNXCLR  DS    0H
         L     R10,NUCPLUPT
         USING PRMSECT,R10
         XC    PRMABNEX,PRMABNEX
         XC    PRMABNUW,PRMABNUW
         DROP  R10
         B     ABNXEXOK
         SPACE 3
ABNXSET  DS    0H
         L     R10,NUCPLUPT
         USING PRMSECT,R10
         MVC   PRMABNEX,16(R3)
         MVC   PRMABNUW,20(R3)
         DROP  R10
         B     ABNXEXOK
         POP   USING
         EJECT ,
         PUSH  USING
         DROP  ,
         USING NUCON,0
ABNXRES  DS    0H
         USING *,R15
         L     R10,NUCPLUPT
         USING PRMSECT,R10
         NI    PRMFLAG1,255-PRMF1ABN  Allow further calls.
         BR    R14
         POP   USING
         TITLE 'DMSFNSMC - FINIS from late VM/SP.'
         PUSH  USING
DMSFNSMC $ENTER ,
         SPACE 3
         LR    R3,R1          Tokenized PLIST.
         MVC   WRKDSKPL,0(R3) Copy DMSFNSMC plist.
         MVC   WRKDSKPL(8),=CL8'FINIS'  Call FINIS instead.
         LA    R1,WRKDSKPL    Issue FINIS
         SVC   202
         DC    AL4(1)
         $EXIT ,
         POP   USING
         TITLE 'EPOINT - Move the read/write file pointers.'
         PUSH  USING
EPOINT   $ENTER ,
*
*        Support FSPOINT with FORM=E, but only as much as the non-E
*        form can implement (i.e., RDPNT and WRPNT < 64K).
*
         SPACE 3
         LR    R3,R1          Tokenized PLIST.
         USING FSCBD,R3
         MVC   WRKDSKPL,0(R3) Copy EPOINT plist.
         L     R0,FSCBWPTR    Get FORM=E write pointer.
         C     R0,=F'65533'   Too big?
         BH    POINERIT       Yes, error.
         STH   R0,WRKDSKPL+(FSCBITNO-FSCBD)  Set it in POINT plist.
         L     R0,FSCBRPTR    Get FORM=E read pointer.
         C     R0,=F'65533'   Too big?
         BH    POINERNR       Yes, error.
         STH   R0,WRKDSKPL+(FSCBBUFF-FSCBD)  Set it in POINT plist.
         MVC   WRKDSKPL+(FSCBCOMM-FSCBD)(8),=CL8'POINT'  Set func.
         LA    R1,WRKDSKPL    Issue
         SVC   202               POINT.
         DC    AL4(1)
         SPACE 1
POINEXIT $EXIT ,
         SPACE 3
POINERIT BAL   R14,MSG021     "Record number <n> is too large"
         B     POINEXIT       Exit.
         SPACE 3
POINERNR BAL   R14,MSG022     "Record count <n> is too large"
         B     POINEXIT       Exit.
         DROP  R3
         POP   USING
         TITLE 'ESTATE / ESTATEW - Verify or open file'
         PUSH  USING
ESTATE   $ENTER ,
         LA    R11,ESTATEX
         BR    R11
         DROP  R11
         SPACE 3
ESTATEW  $ENTER ,
         SPACE 3
         LA    R11,ESTATEX
         BR    R11
         DROP  R11
         SPACE 3
         USING ESTATEX,R11
ESTATEX  DS    0H
*
*        Support FSSTATE with FORM=E.
*
         SPACE 3
         LR    R3,R1          Tokenized PLIST.
         USING FSCBD,R3
         MVC   WRKDSKPL,0(R3) Copy ESTATE / ESTATEW plist.
         MVC   WRKDSKPL+(FSCBCOMM-FSCBD)(7),FSCBCOMM+1  Set w/o 'E'.
         MVI   WRKDSKPL+(FSCBCOMM-FSCBD)+7,C' '  Clr last char.
         LA    R1,WRKDSKPL    Issue
         SVC   202               STATE / STATEW.
         DC    AL4(1)
         MVC   FSCBBUFF,WRKDSKPL+(FSCBBUFF-FSCBD) Pass FST pointer out.
         SPACE 1
STATEXIT $EXIT ,
         SPACE 3
STATERIT BAL   R14,MSG021     "Record number <n> is too large"
         B     STATEXIT       Exit.
         SPACE 3
STATERNR BAL   R14,MSG022     "Record count <n> is too large"
         B     STATEXIT       Exit.
         DROP  R3
         POP   USING
         TITLE 'GLOBALV - Get/set global variables'
         PUSH  USING
GLOBALV  $ENTER ,
*
*        Support getting a specific few GLOBALVs through the stack.
*              FPL/STYLE = 'FPL'
*              FPL/REPOSITOry = '-'
*              FPLTRAP/* = ''
*              */* = ''
*
         SPACE 3
         LR    R3,R1          Tokenized PLIST.
         CLC   =CL8'SELECT',8(R3)  "GLOBALV SELECT"?
         BNE   GBLVOK         No, just say OK.
         LA    R15,4          "Invalid GLOBALV function function"
         CLC   =CL8'STACK',24(R3)  "GLOBALV SELECT ... STACK"?
         BNE   GBLVEXIT       No, error.
         CLI   40(R3),X'FF'   "GLOBALV SELECT ... STACK ... fnc"?
         BNE   GBLVEXIT       No, error.
         CLC   =CL8'FPL',16(R3)  "GLOBALV SELECT FPL STACK"?
         BE    GBLVSFPL       Yes, check var.
         CLC   =CL8'FPLTRAP',16(R3)  "GLOBALV SELECT FPLTRAP STACK"?
         BE    GBLVSFPT       Yes, check var.
         B     GBLVSUNS       No, some unsupported STACK request.
         SPACE 3
GBLVSFPL DS    0H
         LA    R1,=C'FPL'     Assume it's
         ICM   R1,B'1000',=X'03'   SELECT FPL GET STYLE.
         CLC   =CL8'STYLE',32(R3)  Is it?
         BE    GBLVSTAK       Yes, stack our answer.
         LA    R1,=C'-'       Assume it's
         ICM   R1,B'1000',=X'01'   SELECT FPL GET REPOSITORY.
         CLC   =CL8'REPOSITO',32(R3)  Is it?
         BE    GBLVSTAK       Yes, stack our answer.
         SR    R1,R1          No, stack an
         B     GBLVSTAK         empty value.
         SPACE 3
GBLVSFPT DS    0H
         SR    R1,R1          Stack an
         B     GBLVSTAK         empty value.
         SPACE 3
GBLVSUNS DS    0H
         SR    R1,R1          Stack an empty value.
         SPACE 3
GBLVSTAK DS    0H
         MVC   WRKATTPL(8),=CL8'ATTN'  Set
         MVC   WRKATTPL+8(4),=CL4'LIFO'  up
         ST    R1,WRKATTPL+12               plist.
         LA    R1,WRKATTPL    Stack
         SVC   202               response.
         DC    AL4(1)
         B     GBLVEXIT
         SPACE 3
GBLVOK   DS    0H
         SR    R15,R15
GBLVEXIT DS    0H
         $EXIT ,
         POP   USING
         TITLE 'LINERD - Read from console or stack'
         PUSH  USING
         USING NUCON,0
LINERD   $ENTER DATALEN=256
*
*        Support LINERD FORM=SINGLE, as much as RDTERM can.
*
         SPACE 3
         LR    R3,R1          Tokenized PLIST.
         USING LRPLIST,R3
         XC    WRKPLSTS,WRKPLSTS
         MVC   WRKRDTPL(8),=CL8'WAITRD'  Set command.
         LA    R1,WRKDATA
         ST    R1,WRKRDTPL+8
         MVI   WRKRDTPL+8,X'01'    Set constant.
         MVC   WRKRDTPL+12(4),LRPDATAL  Set buffer length.
         CLC   LRPDATAL,=F'256'  Too big?
         BNH   *+8             No, skip.
         DC    H'0,5'          Yes, that's fatal (for now?)
*
*        Set first code byte.  RDTERM only allows certain
*        combinations, we'll approximate the rest.
*
         TM    LRPFLAG1,LRP1PAD  PAD=BLANK?
         BNO   LINRF001       No, skip.
         TM    LRPFLAG1,LRP1UPPR  CASE=UPPER?
         BZ    LINRF001       No, skip.
         MVI   WRKRDTPL+12,C'U'  Yes, that's EDIT=YES.
         B     LINRFEND       Flags are done.
LINRF001 DS    0H
         SPACE 1
         TM    LRPFLAG1,LRP1PAD  PAD=BLANK?
         BNO   LINRF002       No, skip.
         MVI   WRKRDTPL+12,C'S'  Yes, that's EDIT=PAD.
         B     LINRFEND       Flags are done.
LINRF002 DS    0H
         SPACE 1
         TM    LRPFLAG1,LRP1UPPR  CASE=UPPER?
         BZ    LINRF003       No, skip.
         MVI   WRKRDTPL+12,C'V'  Yes, that's EDIT=UPCASE.
         B     LINRFEND       Flags are done.
LINRF003 DS    0H
         SPACE 1
         TM    LRPFLAG1,LRP1PAD  PAD=NONE?
         BNZ   LINRF004       No, skip.
         MVI   WRKRDTPL+12,C'T'  Yes, that's EDIT=NO.
         B     LINRFEND       Flags are done.
LINRF004 DS    0H
         SPACE 1
         TM    LRPFLAG2,LRP2ATTR  ATTREST=YES?
         BZ    LINRF005       No, skip.
         MVI   WRKRDTPL+12,C'*'  Yes, that's EDIT=PHYS,ATTREST=YES.
         B     LINRFEND       Flags are done.
LINRF005 DS    0H
         SPACE 1
         TM    LRPFLAG2,LRP2ATTR  ATTREST=YES?
         BO    LINRF006       No, skip.
         MVI   WRKRDTPL+12,C'$'  Yes, that's EDIT=PHYS,ATTREST=NO.
         B     LINRFEND       Flags are done.
LINRF006 DS    0H
         SPACE 1
         MVI   WRKRDTPL+12,C'X'  None of the above, EDIT=PHYS.
         B     LINRFEND       Flags are done.
         SPACE 1
LINRFEND DS    0H
*        Set second code byte.
         IC    R0,LRPFLAG1    Get TYPE=
         N     R0,=A(LRP1TYPE)   flag.
         CLM   R0,B'0001',=AL1(LRPTYPDI)   TYPE=DIRECT?
         BNE   *+8            No, skip.
         MVI   WRKRDTPL+13,C'D'  Yes, set it.
         SPACE 3
         LA    R1,WRKRDTPL    Issue RDTERM
         ICM   R1,B'1000',=X'04'  with NUCEXT
         SVC   202                   bypass.
         DC    AL4(1)
         C     R15,=F'2'      Bad parms?
         BE    LINRBADP       Yes, tell caller.
         LH    R1,WRKRDTPL+14  Get # bytes read.
         $RETREG REG=R0,VALUE=(R1)  Pass # bytes read back in R0
         BCTR  R1,0           Move data
         L     R2,LRPDATAA       data to
         MVC   0(*-*,R2),WRKDATA    callers
         EX    R1,*-6                  buffer.
         SR    R15,R15        All is well.
LINREXIT $EXIT ,
         SPACE 3
LINRBADP LA    R15,24         LINERD's version of RC=2
         B     LINREXIT       Return to caller.
         POP   USING
         TITLE 'PGMHND - Persistent Program Check handler'
         PUSH  USING
         DROP  ,
         USING NUCON,0
PGMHND   DS    0H
*
*        Entered via PGMNPSW for all program checks.
*
         STM   R0,R15,LOWSAVE  Save regs temporarily.
         BALR  R11,0         Set
         LA    R1,*-PGMHND      up
         SR    R11,R1              local
         USING PGMHND,R11             base.
         L     R1,=A(PGMHND-PLUFNC)  Set
         LR    R12,R11          up
         SR    R12,R1              common
         USING PLUFNC,R12             base.
         SPACE 3
         L     R10,NUCPLUPT
         USING PRMSECT,R10
         ICM   R15,B'1111',PRMABNEX  Do we have an ABNEXIT?
         BZ    PGMH2CMS       No, pass it to CMS.
         TM    PRMFLAG1,PRMF1ABN  Have we tried it already?
         BO    PGMH2CMS       Yes, pass it to CMS.
         OI    PRMFLAG1,PRMF1ABN  No, we have now.
         L     R1,AABWSECT
         USING ABWSECT,R1
         MVC   ABNREGS(16*4),LOWSAVE  Pass regs,
         MVC   ABNPSW,PGMOPSW      PSW,
         MVC   ABNUWRD,PRMABNUW       user word,
         LA    R13,ABNPAS13              and savearea.
         OC    ABNPSW+2(2),=X'00C0'  Turn PROG n into ABEND code.
         BALR  R14,R15         Call ABNEXIT handler.
*
*        If the exit returns to us, let CMS abend continue.
*
         L     R1,AABWSECT    Get the
         MVC   LOWSAVE(16*4),ABNREGS   regs and
         NC    ABNPSW+2(2),=X'FF3F'  Turn ABEND code back to PROG n.
         MVC   PGMOPSW,ABNPSW       PSW back for CMS.
         SPACE 3
PGMH2CMS DS    0H             Pass
         MVC   IPLPSW,PRMPGMNP   the
         LM    R0,R15,LOWSAVE       program check
         LPSW  IPLPSW                  to CMS.
         LTORG ,
         POP   USING
         TITLE 'SVCHND - Persistent SVC handler'
         PUSH  USING
         DROP  ,
SVCHND   DS    0H
*
*        Entered via SVCNPSW for all SVCs.
*
*        BE EXTREMELY CAREFUL HERE!!!
*
         USING NUCON,0
         STM   R0,R15,LOWSAVE
         BALR  R11,0         Set
         LA    R1,*-SVCHND      up
         SR    R11,R1              local
         USING SVCHND,R11             base.
         L     R1,=A(SVCHND-PLUFNC)  Set
         LR    R12,R11          up
         SR    R12,R1              common
         USING PLUFNC,R12             base.
         CLI   SVCOPSW+3,109  Is it ESPIE?
         BE    SVC109         Yes, handle it.
         CLI   SVCOPSW+3,199  Is it our Patch SVC?
         BE    SVC199         Yes, handle it.
         CLI   SVCOPSW+3,204  Is it CMSCALL?
         BE    SVC204         Yes, handle it.
SVCHPASS DS    0H
         L     R10,NUCPLUPT
         USING PRMSECT,R10
         MVC   IPLPSW,PRMSVCNP  Get CMS's SVC-new PSW.
         DROP  R10
         LM    R0,R15,LOWSAVE  Restore regs and
         LPSW  IPLPSW              pass it to CMS.
         SPACE 3
SVCHRTRN DS    0H
         LM    R0,R15,LOWSAVE  SVC will update any it cares to.
         LPSW  SVCOPSW        Return to caller.
         TITLE 'SVC109 - Handle an ESPIE SVC 109.'
SVC109   DS    0H
         LM    R0,R1,LOWSAVE  Get parameter regs.
         CH    R0,=H'4'       ESPIE SET?
         BE    S109SET        Yes, do it.
         CH    R0,=H'8'       ESPIE RESET?
         BE    S109RSET       Yes, do it.
         B     SVCHRTRN       None of the above, ignore it.
         SPACE 3
S109SET  DS    0H
         L     R10,NUCPLUPT
         USING PRMSECT,R10
         XC    PRMS14PA,PRMS14PA  Clear SPIE PICA.
         MVC   PRMS14PA+1(3),1(R1)  Set exit address.
         MVC   PRMS14PA+4(2),4(R1)  Set interrupt list.
         MVI   SVCOPSW+3,14   Say we got SPIE SVC 14.
         LA    R1,PRMS14PA    Pass SPIE PICA
         ST    R1,LOWSAVE+(1*4)  to CMS.
         DROP  R10
         B     SVCHPASS       Let CMS run 109 as 14.
         SPACE 3
S109RSET DS    0H
         L     R10,NUCPLUPT
         USING PRMSECT,R10
         XC    PRMS14PA,PRMS14PA  Clear SPIE PICA.
         MVI   SVCOPSW+3,14   Say we got SPIE SVC 14.
         LA    R1,PRMS14PA    Pass SPIE PICA
         ST    R1,LOWSAVE+(1*4)  to CMS.
         DROP  R10
         B     SVCHPASS       Let CMS run 109 as 14.
         TITLE 'SVC199 - Patch PIPMOD the hard way.'
SVC199   DS    0H
*
*        Patch PIPMOD the hard way.  There are a few things we can't
*        easily do as ZAPs.
*
         L     R1,SVCOPSW+4   -> H'subcode'
         LA    R4,2(,R1)      Point past it.
         STCM  R4,B'0111',SVCOPSW+5  Update return address.
         LH    R3,0(,R1)      Get subcode.
         SLL   R3,2           Get table index.
         C     R3,=A(S199MAX)  Too high?
         BL    S199TBL(R3)    No, go do it.
         DC    H'0,2'         We can't issue a message, so... BOOM!
         SPACE 3
S199TBL  DS    0H             SVC 199 patch codes
         B     S199DI00          0000: Patch DIAG 0000 call.
S199MAX  EQU   (*-S199TBL)/4
         SPACE 3
S199DI00 DS    0H             DIAG 0000 patch.
*
*        Tell Pipelines we're not VM/XA et seq.
*
         LM    R14,R15,LOWSAVE+(R14*4)  Get input regs.
         DIAG  R14,R15,X'0000'  Get CP info.
         ST    R15,LOWSAVE+(15*4)  Pass back length.
         OI    24(R14),X'80'  Turn on the VM/SP bit.
         B     SVCHRTRN       Return from SVC 199.
         TITLE 'SVC204 - Handle a CMSCALL.'
SVC204   DS    0H
         LM    R0,R1,LOWSAVE  Get parameter regs.
         L     R10,NUCPLUPT     Get perm data area.
         USING PRMSECT,R10
         OC    PRMCCPSW,PRMCCPSW  Are we inside a 204?
         BZ    *+8            No, skip.
         DC    H'0,3'           Yes, recursion is fatal.
         MVC   PRMCCPSW,SVCOPSW  Save return PSW.
         LM    R0,R15,LOWSAVE  Get caller's regs.
         DROP  R12
         ICM   R1,B'1000',LOWSAVE+(R15*4)  Get call type.
         SVC   202            Run caller's request.
         DC    AL4(1)         Errors come back here.
         STM   R0,R15,LOWSAVE  Save returned regs.
         BALR  R12,0
         USING *,R12
         L     R10,NUCPLUPT     Get perm data area.
         OC    PRMCCPSW,PRMCCPSW  Are we inside a 204?
         BNZ   *+8            Yes, skip.
         DC    H'0,4'         No, how did we get here?
         MVC   SVCOPSW,PRMCCPSW  Get return PSW.
         XC    PRMCCPSW,PRMCCPSW  We aren't inside 204 anymore.
         LM    R0,R15,LOWSAVE  Get returned regs.
         LPSW  SVCOPSW        Return to caller.
         SPACE 3
         LTORG ,
         POP   USING
         TITLE 'WAITRD - Read from the console.'
         PUSH  USING
WAITRD   $ENTER ,
         SPACE 3
         LR    R3,R1          Tokenized PLIST.
         MVC   WRKRDTPL,0(R3)
*
*        I have no idea what RDTERM code 'W' means, but the Pipelines
*        CONSOLE stage (at least) uses it.  Code 'T' (EDIT=NO) seems
*        to be the best substititute that VM/370 CMS supports.
*
         CLI   WRKRDTPL+12,C'W'  Is it code 'W'?
         BNE   *+8            No, skip
         MVI   WRKRDTPL+12,C'T'  Yes, recode it.
         LA    R1,WRKRDTPL    Issue RDTERM
         ICM   R1,B'1000',=X'04'  with NUCEXT
         SVC   202                   bypass.
         DC    AL4(1)
         LTR   R15,R15        Error?
         BNZ   *+10           Yes, don't update length.
         MVC   14(2,R3),WRKRDTPL+14  Get # bytes read.
         $EXIT ,
         POP   USING
         TITLE 'RDBUF / WRBUF - Read or write file records.'
         PUSH  USING
RDBUF    $ENTER ,
*
*        Support FSREAD FORM=E, but only as much as the non-E form can
*        implement (i.e., NOREC and RECNO < 64K).
*
         LA    R11,XXBUF
         BR    R11
         DROP  R11
         SPACE 3
WRBUF    $ENTER ,
*
*        Support FSWRITE FORM=E, but only as much as the non-E form can
*        implement (i.e., NOREC and RECNO < 64K).
*
         LA    R11,XXBUF
         BR    R11
         DROP  R11
         SPACE 3
         USING XXBUF,R11
XXBUF    DS    0H
         SPACE 3
         LR    R3,R1          Tokenized PLIST.
         USING FSCBD,R3
         TM    FSCBFLG,FSCBFEPL  Is it FORM=E?
         BZ    XXBFNOTE       No, Just reissue it w/ bypass-NUCEXT.
         SPACE 3
         MVC   WRKDSKPL,0(R3) Copy RDBUF / WRBUF plist.
         L     R0,FSCBAITN    Get FORM=E record number.
         C     R0,=F'65533'   Too big?
         BH    XXBFERIT       Yes, error.
         STH   R0,WRKDSKPL+(FSCBITNO-FSCBD)  Set it in XXBFE plist.
         L     R0,FSCBANIT    Get FORM=E record count.
         C     R0,=F'65533'   Too big?
         BH    XXBFERNR       Yes, error.
         STH   R0,WRKDSKPL+(FSCBNOIT-FSCBD)  Set it in XXBFE plist.
         A     R0,FSCBAITN    Get last-record number.
         C     R0,=F'65533'   Too big?
         BH    XXBFERIT       Yes, error.
         NI    WRKDSKPL+(FSCBFLG-FSCBD),255-FSCBFEPL  It's not FORM=E.
         LA    R1,WRKDSKPL    Issue RDBUF / WRBUF
         ICM   R1,B'1000',=X'04'  with NUCEXT
         SVC   202                   bypass.
         DC    AL4(1)
         CLI   FSCBCOMM,C'R'  Is this RDBUF?
         BNE   *+10           No, skip.
         MVC   FSCBNORD,WRKDSKPL+(FSCBNORD-FSCBD) Yes, set byte cnt.
         SPACE 1
XXBFEXIT $EXIT ,
         SPACE 3
XXBFNOTE DS    0H
         LR    R1,R3             Get FSCB.
         ICM   R1,B'1000',=X'04' Reissue it
         SVC   202                  with bypass-NUCEXT flag.
         DC    AL4(1)
         B     XXBFEXIT
         SPACE 3
XXBFERIT BAL   R14,MSG021     "Record number <n> is too large"
         B     XXBFEXIT       Exit.
         SPACE 3
XXBFERNR BAL   R14,MSG022     "Record count <n> is too large"
         B     XXBFEXIT       Exit.
         DROP  R3
         POP   USING
         LTORG ,
         TITLE 'FORM=E File System Control Block'
         FSCBD ,
FSCBAITN DS    F              FORM=E record number.
FSCBANIT DS    F              FORM=E record count.
FSCBWPTR DS    F              FORM=E write record number.
FSCBRPTR DS    F              FORM=E read record number.
FSCBLEN  EQU   *-FSCBD
         SPACE 1
*        FSCBFLG bits
FSCBFEPL EQU   X'20'          FORM=E specified.
         TITLE 'LINERD PLIST.'
LRPLIST  DSECT ,
LRPCMD   DS    CL8            'LINERD'
LRPDATAA DS    A              Address of data buffer
LRPDATAL DS    F              Length of data buffer
LRPVSCRA DS    A              Address of VSceeen name
LRPLINEA DS    A              Address of line number
LRPCOLA  DS    A              Address of column number
LRPPROMA DS    A              Address of prompt text
LRPPROML DS    F              Length of prompt text
LRPFLAG1 DS    X              Flags:
LRP1PAD  EQU   B'11000000'       Padding type
LRP1TYPE EQU   B'00111000'       Input type
LRP1LOG  EQU   B'00000100'       LOGICAL=YES?
LRP1TRAN EQU   B'00000010'       TRANSLATE=YES?
LRP1UPPR EQU   B'00000001'       CASE=UPPER?
LRPFLAG2 DS    X              Flags:
LRP2WAIT EQU   B'10000000'       WAIT=YES?
LRP2ATTR EQU   B'01000000'       ATTREST=YES?
*  Values for LRP1PAD:
LRPPADBL EQU   B'11000000'    PAD=BLANK
LRPPADNL EQU   B'01000000'    PAD=NULL
LRPPADNO EQU   B'00000000'    PAD=NONE
*  Values for LRP1TYP:
LRPTYPDI EQU   B'00100000'    TYPE=DIRECT
LRPTYPIV EQU   B'00010000'    TYPE=INVSIBLE
LRPTYPST EQU   B'00001000'    TYPE=STACK
LRPTYPNS EQU   B'00000000'    TYPE=NOSTACK
         TITLE 'Permanent storage.'
         PLUPRM ,
         TITLE 'Working storage.'
WRKSECT  DSECT ,
WRKSAVE  DS    18F            Save area (must be first in DSECT).
WRKUSAVE DS    F              Address of USERSAVE for nucext.
WRKLEND  DS    F              Size of this WRKSECT in doublewords.
         SPACE 1
WRKPLST1 DS    0D             Assorted plists, sharing space.
WRKATTPL DS    CL8,CL4,F      ATTN plist.
         ORG   WRKPLST1
WRKDSKPL DS    XL(FSCBLEN)    File I/O plist.
         ORG   WRKPLST1
WRKLEDPL LINEDIT MF=L,MAXSUBS=3  LINEDIT plist.
         ORG   WRKPLST1
WRKNXCPL NUCEXT CLR,MF=L      NUCEXT CLR plist.
         ORG   WRKPLST1
WRKNXSPL NUCEXT SET,MF=L      NUCEXT SET plist.
         ORG   WRKPLST1
WRKRDTPL DS    XL16           RDTERM plist (no macro).
         ORG   ,
WRKPLSTS EQU   WRKPLST1,*-WRKPLST1
WRKDATA  DS    0D             Start of variable data area.
WRKLEN   EQU   *-WRKSECT
         TITLE 'DSECTs.'
FUNCENT  DSECT ,
FUNCNAME DS    CL8            Function name.
FUNCEP   DS    A              Offset to entrypoint.
         EJECT ,
         DMSABW ,
         ORG   ABWSECT+X'F4'
ABNUWRD  DS    F             ABNEXIT user word.
         ORG   ,
         EJECT ,
         NUCON ,
         ORG   NUCON+X'E70'
ADMSABXR DS    A              ABNEXIT RESET entrypoint.
         ORG   NUCON+X'FFC'
NUCPLUPT DS    A              -> PLUNGER PRMSECT.
         ORG   ,
         EJECT ,
         REGEQU ,
         SCBLOCK ,
         SVCSAVE ,
         USERSAVE ,
         END   ,