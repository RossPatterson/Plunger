   I=I+1; A.I = "CALLTYP  DC    X'01000000'"
   I=I+1; A.I = "         END"
   A.0 = I
   Call Assemble 'A.', 'TS204'
   'LOAD TS204 ( START'
   Call Erase 'TS204 * A'
   Return

TestWaitRd:
