/* Unit tests for PLUNGER functions (NUCEXTs, etc.). */

TestSetup:
   /* Ensure WITHSTEM is available. */
   Call NoError 'NUCEXT WITHSTEM'
   If RC <> 0 then 'NUCXTEXT WITHSTEM (SYSTEM'

   /* Reset PLUNGER to clean state. */
   Call NoError 'NUCEXT PLUNGER'
   If RC = 0 then Call NoError 'NUCXDROP PLUNGER'
   'PLUNGER ENABLE'
   Return

TestTeardown:
   'SET CMSTYPE RT'
   'NUCXDROP WITHSTEM'
   'PLUNGER DISABLE'
   Return

TestAbnExit:
   Call Erase 'TAEX * A'
   I=0
   I=I+1; A.I = "TAEX     START X'20000'"
   I=I+1; A.I = "         USING *,12"
   I=I+1; A.I = "         LR    12,15"
   I=I+1; A.I = "         ST    14,RETADDR"
   I=I+1; A.I = "         CNOP  0,4"
   I=I+1; A.I = "         BAL   1,SET"
   I=I+1; A.I = "         DC    CL8'ABNEXIT'"
   I=I+1; A.I = "         DC    CL8'SET'"
   I=I+1; A.I = "         DC    A(EXIT)"
   I=I+1; A.I = "         DC    A(UWORD)"
   I=I+1; A.I = "         DC    8X'FF'"
   I=I+1; A.I = "SET      SVC   202"
   I=I+1; A.I = "         DC    AL4(RET14)"
   I=I+1; A.I = "         DC    H'0'"
   I=I+1; A.I = "EXIT     DS    0H"
   I=I+1; A.I = "         BALR  12,0"
   I=I+1; A.I = "         USING *,12"
   I=I+1; A.I = "         CNOP  0,4"
   I=I+1; A.I = "         BAL   1,CLR"
   I=I+1; A.I = "         DC    CL8'ABNEXIT'"
   I=I+1; A.I = "         DC    CL8'CLR'"
   I=I+1; A.I = "         DC    A(EXIT)"
   I=I+1; A.I = "         DC    8X'FF'"
   I=I+1; A.I = "CLR      SVC   202"
   I=I+1; A.I = "         DC    AL4(RETURN)"
   I=I+1; A.I = "RETURN   L     14,RETADDR"
   I=I+1; A.I = "RET14    BR    14"
   I=I+1; A.I = "UWORD    DS    A"
   I=I+1; A.I = "RETADDR  DS    A"
   I=I+1; A.I = "         END"
   A.0 = I
   Call Assemble 'A.', 'TAEX'
   Call NoError 'CP DISCARD TRACE END'
   'LOAD TAEX ( START'
   Call Erase 'TAEX * A'
   Return

TestDMSFNSMC:
   Call Erase 'TDF DATA A'
   'EXECIO 1 DISKW TDF DATA A (STRING blah blah blah'
   'DMSFNSMC TDF DATA A'
   Call Erase 'TDF DATA A'
   Return

TestEPointRead:
   Call Erase 'TEPR * A'
   I=0
   I=I+1; A.I = "TEPR     START X'20000'"
   I=I+1; A.I = "         USING *,12"
   TargetRecord = I
   I=I+1; A.I = "         LR    12,15"
   I=I+1; A.I = "         LR    2,14"
   I=I+1; A.I = "         CNOP  0,4"
   I=I+1; A.I = "         BAL   1,DOIT"
   I=I+1; A.I = "         DC    CL8'EPOINT'"
   I=I+1; A.I = "         DC    CL8'TEPR'"
   I=I+1; A.I = "         DC    CL8'ASSEMBLE'"
   I=I+1; A.I = "         DC    CL2'A'"
   I=I+1; A.I = "         DC    HL2'-9'     normal WRPNT="
   I=I+1; A.I = "         DC    HL2'-9'     normal RDPNT="
   I=I+1; A.I = "         DC    H'0'"
   I=I+1; A.I = "         DC    F'0'"
   I=I+1; A.I = "         DC    CL2'F'"
   I=I+1; A.I = "         DC    H'-1'       normal RECNO="
   I=I+1; A.I = "         DC    F'0'"
   I=I+1; A.I = "         DC    F'-1'       FORM=E RECNO="
   I=I+1; A.I = "         DC    F'-1'       FORM=E NOREC="
   I=I+1; A.I = "         DC    F'0'        FORM=E WRPNT="
   I=I+1; A.I = "         DC    F'" || TargetRecord || "'        FORM=E RDPNT="
   I=I+1; A.I = "DOIT     SVC   202"
   I=I+1; A.I = "         DC    AL4(1)"
   I=I+1; A.I = "         BR    2"
   I=I+1; A.I= "          END"
   A.0 = I
   Call Assemble 'A.', 'TEPR'
   'LOAD TEPR ( START'
   'EXECIO 1 DISKR TEPR ASSEMBLE A ( VAR OUT'
   Call Erase 'TEPR * A'
   Call AssertIdentical Left(A.TargetRecord, 80), Out
   Return

TestEPointWrite:
   Call Erase 'TEPW * A'
   I=0
   I=I+1; A.I = "TEPW     START X'20000'"
   I=I+1; A.I = "         USING *,12"
   I=I+1; A.I = "         LR    12,15"
   TargetRecord = I
   I=I+1; A.I = "         LR    2,14"
   I=I+1; A.I = "         CNOP  0,4"
   I=I+1; A.I = "         BAL   1,DOIT"
   I=I+1; A.I = "         DC    CL8'EPOINT'"
   I=I+1; A.I = "         DC    CL8'TEPW'"
   I=I+1; A.I = "         DC    CL8'ASSEMBLE'"
   I=I+1; A.I = "         DC    CL2'A'"
   I=I+1; A.I = "         DC    HL2'-9'     normal WRPNT="
   I=I+1; A.I = "         DC    HL2'-9'     normal RDPNT="
   I=I+1; A.I = "         DC    H'0'"
   I=I+1; A.I = "         DC    F'0'"
   I=I+1; A.I = "         DC    CL2'F'"
   I=I+1; A.I = "         DC    H'-1'       normal RECNO="
   I=I+1; A.I = "         DC    F'0'"
   I=I+1; A.I = "         DC    F'-1'       FORM=E RECNO="
   I=I+1; A.I = "         DC    F'-1'       FORM=E NOREC="
   I=I+1; A.I = "         DC    F'" || TargetRecord || "'        FORM=E WRPNT="
   I=I+1; A.I = "         DC    F'0'        FORM=E RDPNT="
   I=I+1; A.I = "DOIT     SVC   202"
   I=I+1; A.I = "         DC    AL4(1)"
   I=I+1; A.I = "         BR    2"
   I=I+1; A.I= "          END"
   A.0 = I
   Call Assemble 'A.', 'TEPW'
   'LOAD TEPW ( START'
   A.TargetRecord = Left(" Blah blah BLAH!", 80)
   'EXECIO 1 DISKW TEPW ASSEMBLE A ( VAR A.' || TargetRecord 'FINIS'
   'EXECIO * DISKR TEPW ASSEMBLE A (STEM O.'
   Call Erase 'TEPW * A'
   Call AssertStemEqual 'A.', 'O.'
   Return

TestEState:
   Call Erase 'TES DATA A'
   Call NoError 'ESTATE TES DATA A'
   Call AssertEqual 28, RC
   'EXECIO 1 DISKW TES DATA A (FINIS STRING blah blah blah'
   'ESTATE TES DATA A'
   Call Erase 'TES DATA A'
   Return

TestEStateW:
   Call Erase 'TESW DATA A'
   Call NoError 'ESTATEW TESW DATA A'
   Call AssertEqual 28, RC
   'EXECIO 1 DISKW TESW DATA A (FINIS STRING blah blah blah'
   'ESTATEW TESW DATA A'
   Call Erase 'TESW DATA A'
   Return

TestGlobalVNoSelect:
   'GLOBALV BANANA'
   Call AssertEqual 0, Queued()
   Return

TestGlobalVExtraParms:
   Call NoError 'GLOBALV SELECT KUMQUAT APPLE FNORD'
   Call AssertEqual 4, RC
   Return

TestGlobalVUknownPool:
   'GLOBALV SELECT KUMQUAT STACK BLUETTE'
   Call AssertEqual 1, Queued()
   Parse pull Value
   Call AssertIdentical '', Value
   Return

TestGlobalVFplUnknownVar:
   'GLOBALV SELECT FPL STACK DEADBEEF'
   Call AssertEqual 1, Queued()
   Parse pull Value
   Call AssertIdentical '', Value
   Return

TestGlobalVFplStyle:
   'GLOBALV SELECT FPL STACK STYLE'
   Call AssertEqual 1, Queued()
   Parse pull Value
   Call AssertIdentical 'FPL', Value
   Return

TestGlobalVFplRepo:
   'GLOBALV SELECT FPL STACK REPOSITORY'
   Call AssertEqual 1, Queued()
   Parse pull Value
   Call AssertIdentical '-', Value
   Return

TestGlobalVFpltrap:
   'GLOBALV SELECT FPLTRAP STACK OINK'
   Call AssertEqual 1, Queued()
   Parse pull Value
   Call AssertIdentical '', Value
   Return

TestRdBuf:
   Call Erase 'TRB * A'
   I=0
   I=I+1; A.I = "TRB      START X'20000'"
   I=I+1; A.I = "         USING *,12"
   I=I+1; A.I = "         LR    12,15"
   I=I+1; A.I = "         LR    2,14"
   I=I+1; A.I = "*        FSREAD 'FN FT FM',FORM=E,BUFFER=BUFFER,BSIZE=256,"
   I=I+1; A.I = "*              RECFM=F,RECNO=4"
   I=I+1; A.I = "         CNOP  0,4"
   I=I+1; A.I = "         BAL   1,DOIT"
   TargetRecord = I
   I=I+1; A.I = "         DC    CL8'RDBUF'"
   I=I+1; A.I = "         DC    CL8'TRB'"
   I=I+1; A.I = "         DC    CL8'ASSEMBLE'"
   I=I+1; A.I = "         DC    CL2'A'"
   I=I+1; A.I = "         DC    AL2(0)"
   I=I+1; A.I = "         DC    AL4(BUFFER)"
   I=I+1; A.I = "         DC    AL4(L'BUFFER)"
   I=I+1; A.I = "         DC    C'F'"
   I=I+1; A.I = "         DC    X'20'        FORM=E"
   I=I+1; A.I = "         DC    AL2(99)"
   I=I+1; A.I = "         DC    AL4(0)"
   I=I+1; A.I = "         DC    F'" || TargetRecord || "'         FORM=E recno"
   I=I+1; A.I = "         DC    F'1'         FORM=E norec"
   I=I+1; A.I = "DOIT     SVC   202"
   I=I+1; A.I = "         DC    AL4(RETURN)"
   I=I+1; A.I = "         LA    15,901"
   I=I+1; A.I = "         CLC   =C'         BAL   1,DOIT ',BUFFER"
   I=I+1; A.I = "         BNE   RETURN"
   I=I+1; A.I = "         LA    15,902"
   I=I+1; A.I = "         CLC   =F'80',40(1)"
   I=I+1; A.I = "         BNE   RETURN"
   I=I+1; A.I = "         SR    15,15"
   I=I+1; A.I = "RETURN   BR    2"
   I=I+1; A.I = "BUFFER   DS    CL80"
   I=I+1; A.I = "         END"
   A.0 = I
   Call Assemble 'A.', 'TRB'
   'LOAD TRB ( START'
   Call Erase 'TRB * A'
   Return

TestSvc204:
