TestGlobalVNoSelect:
   'GLOBALV BANANA'
   Call AssertEqual 0, Queued()
   Return

TestGlobalVExtraParms:
   Call NoError 'GLOBALV SELECT KUMQUAT APPLE FNORD'
   Call AssertEqual 4, RC
   Return

TestGlobalVUknownPool:
   'GLOBALV SELECT KUMQUAT STACK BLUETTE'
   Call AssertEqual 1, Queued()
   Parse pull Value
   Call AssertIdentical '', Value
   Return

TestGlobalVFplUnknownVar:
   'GLOBALV SELECT FPL STACK DEADBEEF'
   Call AssertEqual 1, Queued()
   Parse pull Value
   Call AssertIdentical '', Value
   Return

TestGlobalVFplStyle:
   'GLOBALV SELECT FPL STACK STYLE'
   Call AssertEqual 1, Queued()
   Parse pull Value
   Call AssertIdentical 'FPL', Value
   Return

TestGlobalVFplRepo:
   'GLOBALV SELECT FPL STACK REPOSITORY'
   Call AssertEqual 1, Queued()
   Parse pull Value
   Call AssertIdentical '-', Value
   Return

TestGlobalVFpltrap:
   'GLOBALV SELECT FPLTRAP STACK OINK'
   Call AssertEqual 1, Queued()
   Parse pull Value
   Call AssertIdentical '', Value
   Return

TestLineRd:
   Call Erase 'TLR * A'
   I=0
   I=I+1; A.I = "TLR      START X'20000'"
   I=I+1; A.I = "         USING *,12"
   I=I+1; A.I = "         LR    12,15"
   I=I+1; A.I = "         LR    2,14"
   I=I+1; A.I = "*        LINERD DATA=(BUFFER,L'BUFFER),CASE=UPPER,PAD=BLANK"
   I=I+1; A.I = "         CNOP  0,4"
   I=I+1; A.I = "         BAL   1,DOIT"
   I=I+1; A.I = "         DC    CL8'LINERD'"
   I=I+1; A.I = "         DC    A(BUFFER)"
   I=I+1; A.I = "         DC    A(L'BUFFER)"
   I=I+1; A.I = "         DC    4A(0)"
   I=I+1; A.I = "         DC    F'0'"
   I=I+1; A.I = "         DC    B'11001111'  PAD=BLANK,CASE=UPPER"
   I=I+1; A.I = "         DC    X'00'        TYPE=not DIRECT"
   I=I+1; A.I = "         DC    XL2'0'"
   I=I+1; A.I = "         DC    2F'0'"
   I=I+1; A.I = "DOIT     SVC   202"
   I=I+1; A.I = "         DC    AL4(RETURN)"
   I=I+1; A.I = "         LA    15,901"
   I=I+1; A.I = "         C     0,=F'29'"
   I=I+1; A.I = "         BNE   RETURN"
   I=I+1; A.I = "         LA    15,902"
   I=I+1; A.I = "         CLC   =C'NOWISTHEWINTEROFOURDISCONTENT',BUFFER"
   I=I+1; A.I = "         BNE   RETURN"
   I=I+1; A.I = "         SR    15,15"
   I=I+1; A.I = "RETURN   BR    2"
   I=I+1; A.I = "BUFFER   DS    CL80"
   I=I+1; A.I = "         END"
   A.0 = I
   Call Assemble 'A.', 'TLR'
   Queue 'NowIsTheWinterOfOurDiscontent'
   'LOAD TLR ( START'
   Call Erase 'TLR * A'
   Return

TestRdBuf:
   Call Erase 'TRB * A'
   I=0
   I=I+1; A.I = "TRB      START X'20000'"
   I=I+1; A.I = "         USING *,12"
   I=I+1; A.I = "         LR    12,15"
   I=I+1; A.I = "         LR    2,14"
   I=I+1; A.I = "*        FSREAD 'FN FT FM',FORM=E,BUFFER=BUFFER,BSIZE=256,"
   I=I+1; A.I = "*              RECFM=F,RECNO=4"
   I=I+1; A.I = "         CNOP  0,4"
   I=I+1; A.I = "         BAL   1,DOIT"
   TargetRecord = I
   I=I+1; A.I = "         DC    CL8'RDBUF'"
   I=I+1; A.I = "         DC    CL8'TRB'"
   I=I+1; A.I = "         DC    CL8'ASSEMBLE'"
   I=I+1; A.I = "         DC    CL2'A'"
   I=I+1; A.I = "         DC    AL2(0)"
   I=I+1; A.I = "         DC    AL4(BUFFER)"
   I=I+1; A.I = "         DC    AL4(L'BUFFER)"
   I=I+1; A.I = "         DC    C'F'"
   I=I+1; A.I = "         DC    X'20'        FORM=E"
   I=I+1; A.I = "         DC    AL2(99)"
   I=I+1; A.I = "         DC    AL4(0)"
   I=I+1; A.I = "         DC    F'" || TargetRecord || "'         FORM=E recno"
   I=I+1; A.I = "         DC    F'1'         FORM=E norec"
   I=I+1; A.I = "DOIT     SVC   202"
   I=I+1; A.I = "         DC    AL4(RETURN)"
   I=I+1; A.I = "         LA    15,901"
   I=I+1; A.I = "         CLC   =C'         BAL   1,DOIT ',BUFFER"
   I=I+1; A.I = "         BNE   RETURN"
   I=I+1; A.I = "         LA    15,902"
   I=I+1; A.I = "         CLC   =F'80',40(1)"
   I=I+1; A.I = "         BNE   RETURN"
   I=I+1; A.I = "         SR    15,15"
   I=I+1; A.I = "RETURN   BR    2"
   I=I+1; A.I = "BUFFER   DS    CL80"
   I=I+1; A.I = "         END"
   A.0 = I
   Call Assemble 'A.', 'TRB'
   'LOAD TRB ( START'
   Call Erase 'TRB * A'
   Return

TestSvc109:
   Call Erase 'TS109 * A'
   I=0
   I=I+1; A.I = "TS109    START X'20000'"
   I=I+1; A.I = "         USING *,12"
   I=I+1; A.I = "         LR    12,15"
   I=I+1; A.I = "         ST    14,RETADDR"
   I=I+1; A.I = "         LA    0,4          SET"
   I=I+1; A.I = "         CNOP  0,4"
   I=I+1; A.I = "         BAL   1,SET"
   I=I+1; A.I = "         DC    X'00'"
   I=I+1; A.I = "         DC    AL3(EXIT)"
   I=I+1; A.I = "         DC    X'7FFF0000'"
   I=I+1; A.I = "SET      SVC   109"
   I=I+1; A.I = "         DC    H'0'"
   I=I+1; A.I = "EXIT     LA    0,8          RESET"
   I=I+1; A.I = "         SVC   109"
   I=I+1; A.I = "RETURN   BALR  12,0"
   I=I+1; A.I = "         USING *,12"
   I=I+1; A.I = "         L     14,RETADDR"
   I=I+1; A.I = "         SR    15,15"
   I=I+1; A.I = "         BR    14"
   I=I+1; A.I = "RETADDR  DS    A"
   I=I+1; A.I = "         END"
   A.0 = I
   Call Assemble 'A.', 'TS109'
   Call NoError 'CP DISCARD TRACE END'
   'LOAD TS109 ( START'
   Call Erase 'TS109 * A'
   Return

TestSvc204:
