/* Unit tests for PLUNGER functions (NUCEXTs, etc.). */

TestSetup:
   /* Is HRC100DS installed? */
   Call NoError 'EXECSTAT * *'
   HasHRC100DS = (RC <> -3)

   /* Ensure WITHSTEM is available. */
   Call NoError 'NUCEXT WITHSTEM'
   If RC <> 0 then 'NUCXTEXT WITHSTEM (SYSTEM'

   /* Reset PLUNGER to clean state. */
   Call NoError 'NUCEXT PLUNGER'
   If RC = 0 then Call NoError 'NUCXDROP PLUNGER'
   'PLUNGER ENABLE'
   Return

TestTeardown:
   'SET CMSTYPE RT'
   'NUCXDROP WITHSTEM'
   'PLUNGER DISABLE'
   Return

TestAbnExit:
   Call Erase 'TAEX * A'
   I=0
   I=I+1; A.I = "TAEX     START X'20000'"
   I=I+1; A.I = "         USING *,12"
   I=I+1; A.I = "         LR    12,15"
   I=I+1; A.I = "         ST    14,RETADDR"
   I=I+1; A.I = "         CNOP  0,4"
   I=I+1; A.I = "         BAL   1,SET"
   I=I+1; A.I = "         DC    CL8'ABNEXIT'"
   I=I+1; A.I = "         DC    CL8'SET'"
   I=I+1; A.I = "         DC    A(EXIT)"
   I=I+1; A.I = "         DC    A(UWORD)"
   I=I+1; A.I = "         DC    8X'FF'"
   I=I+1; A.I = "SET      SVC   202"
   I=I+1; A.I = "         DC    AL4(RET14)"
   I=I+1; A.I = "         DC    H'0'"
   I=I+1; A.I = "EXIT     DS    0H"
   I=I+1; A.I = "         BALR  12,0"
   I=I+1; A.I = "         USING *,12"
   I=I+1; A.I = "         CNOP  0,4"
   I=I+1; A.I = "         BAL   1,CLR"
   I=I+1; A.I = "         DC    CL8'ABNEXIT'"
   I=I+1; A.I = "         DC    CL8'CLR'"
   I=I+1; A.I = "         DC    A(EXIT)"
   I=I+1; A.I = "         DC    8X'FF'"
   I=I+1; A.I = "CLR      SVC   202"
   I=I+1; A.I = "         DC    AL4(RETURN)"
   I=I+1; A.I = "RETURN   L     14,RETADDR"
   I=I+1; A.I = "RET14    BR    14"
   I=I+1; A.I = "UWORD    DS    A"
   I=I+1; A.I = "RETADDR  DS    A"
   I=I+1; A.I = "         END"
   A.0 = I
   Call Assemble 'A.', 'TAEX'
   Call NoError 'CP DISCARD TRACE END'
   'LOAD TAEX ( START'
   Call Erase 'TAEX * A'
   Return

TestDMSFNSMC:
   Call Erase 'TDF DATA A'
   'EXECIO 1 DISKW TDF DATA A (STRING blah blah blah'
   'DMSFNSMC TDF DATA A'
   Call Erase 'TDF DATA A'
   Return

TestEPointRead:
   Call Erase 'TEPR * A'
   I=0
   I=I+1; A.I = "TEPR     START X'20000'"
   I=I+1; A.I = "         USING *,12"
   TargetRecord = I
   I=I+1; A.I = "         LR    12,15"
   I=I+1; A.I = "         LR    2,14"
   I=I+1; A.I = "         CNOP  0,4"
   I=I+1; A.I = "         BAL   1,DOIT"
   I=I+1; A.I = "         DC    CL8'EPOINT'"
   I=I+1; A.I = "         DC    CL8'TEPR'"
   I=I+1; A.I = "         DC    CL8'ASSEMBLE'"
   I=I+1; A.I = "         DC    CL2'A'"
   I=I+1; A.I = "         DC    HL2'-9'     normal WRPNT="
   I=I+1; A.I = "         DC    HL2'-9'     normal RDPNT="
   I=I+1; A.I = "         DC    H'0'"
   I=I+1; A.I = "         DC    F'0'"
   I=I+1; A.I = "         DC    CL2'F'"
   I=I+1; A.I = "         DC    H'-1'       normal RECNO="
   I=I+1; A.I = "         DC    F'0'"
   I=I+1; A.I = "         DC    F'-1'       FORM=E RECNO="
   I=I+1; A.I = "         DC    F'-1'       FORM=E NOREC="
   I=I+1; A.I = "         DC    F'0'        FORM=E WRPNT="
   I=I+1; A.I = "         DC    F'" || TargetRecord || "'        FORM=E RDPNT="
   I=I+1; A.I = "DOIT     SVC   202"
   I=I+1; A.I = "         DC    AL4(1)"
   I=I+1; A.I = "         BR    2"
   I=I+1; A.I= "          END"
   A.0 = I
   Call Assemble 'A.', 'TEPR'
   'LOAD TEPR ( START'
   'EXECIO 1 DISKR TEPR ASSEMBLE A ( VAR OUT'
   Call Erase 'TEPR * A'
   Call AssertIdentical Left(A.TargetRecord, 80), Out
   Return

TestEPointWrite:
   Call Erase 'TEPW * A'
   I=0
   I=I+1; A.I = "TEPW     START X'20000'"
   I=I+1; A.I = "         USING *,12"
   I=I+1; A.I = "         LR    12,15"
   TargetRecord = I
   I=I+1; A.I = "         LR    2,14"
   I=I+1; A.I = "         CNOP  0,4"
   I=I+1; A.I = "         BAL   1,DOIT"
   I=I+1; A.I = "         DC    CL8'EPOINT'"
   I=I+1; A.I = "         DC    CL8'TEPW'"
   I=I+1; A.I = "         DC    CL8'ASSEMBLE'"
   I=I+1; A.I = "         DC    CL2'A'"
   I=I+1; A.I = "         DC    HL2'-9'     normal WRPNT="
   I=I+1; A.I = "         DC    HL2'-9'     normal RDPNT="
   I=I+1; A.I = "         DC    H'0'"
   I=I+1; A.I = "         DC    F'0'"
   I=I+1; A.I = "         DC    CL2'F'"
   I=I+1; A.I = "         DC    H'-1'       normal RECNO="
   I=I+1; A.I = "         DC    F'0'"
   I=I+1; A.I = "         DC    F'-1'       FORM=E RECNO="
   I=I+1; A.I = "         DC    F'-1'       FORM=E NOREC="
   I=I+1; A.I = "         DC    F'" || TargetRecord || "'        FORM=E WRPNT="
   I=I+1; A.I = "         DC    F'0'        FORM=E RDPNT="
   I=I+1; A.I = "DOIT     SVC   202"
   I=I+1; A.I = "         DC    AL4(1)"
   I=I+1; A.I = "         BR    2"
   I=I+1; A.I= "          END"
   A.0 = I
   Call Assemble 'A.', 'TEPW'
   'LOAD TEPW ( START'
   A.TargetRecord = Left(" Blah blah BLAH!", 80)
   'EXECIO 1 DISKW TEPW ASSEMBLE A ( VAR A.' || TargetRecord 'FINIS'
   'EXECIO * DISKR TEPW ASSEMBLE A (STEM O.'
   Call Erase 'TEPW * A'
   Call AssertStemEqual 'A.', 'O.'
   Return

TestEState:
   Call Erase 'TES DATA A'
   Call NoError 'ESTATE TES DATA A'
   Call AssertEqual 28, RC
   'EXECIO 1 DISKW TES DATA A (FINIS STRING blah blah blah'
   'ESTATE TES DATA A'
   Call Erase 'TES DATA A'
   Return

TestEStateW:
   Call Erase 'TESW DATA A'
   Call NoError 'ESTATEW TESW DATA A'
   Call AssertEqual 28, RC
   'EXECIO 1 DISKW TESW DATA A (FINIS STRING blah blah blah'
   'ESTATEW TESW DATA A'
   Call Erase 'TESW DATA A'
   Return

TestExecBalrDisk:
   Call Erase 'TEXBD * A'
   I=0
   I=I+1; A.I = "TEXBD    START X'20000'"
   I=I+1; A.I = "         BALR  11,0"
   I=I+1; A.I = "         USING *,11"
   I=I+1; A.I = "         STM   0,15,SAVE"
   I=I+1; A.I = "         CNOP  0,4"
   I=I+1; A.I = "         BAL   1,DOIT"
   I=I+1; A.I = "         DC    CL8'EXEC'"
   I=I+1; A.I = "         DC    CL8'TEXBD'"
   I=I+1; A.I = "         DC    CL8'Hi'"
   I=I+1; A.I = "         DC    CL8'Mom!'"
   I=I+1; A.I = "         DC    8X'FF'"
   I=I+1; A.I = "DOIT     DS    0H"
   If HasHRC100DS then Do
      I=I+1; A.I = "         L     12,AEXEC(,0)"
   End
   Else Do
      I=I+1; A.I = "         MVC   PSW(2),=X'FFE0'"
      I=I+1; A.I = "         L     12,NUCPLUEX(,0)"
   End
   I=I+1; A.I = "         ST    12,PSW+4"
   I=I+1; A.I = "         LR    15,12"
   I=I+1; A.I = "         LA    14,EXECRET"
   I=I+1; A.I = "         LPSW  PSW"
   I=I+1; A.I = "EXECRET  BALR  11,0"
   I=I+1; A.I = "         USING *,11"
   I=I+1; A.I = "         LA    3,901"
   I=I+1; A.I = "         C     15,=F'92'"
   I=I+1; A.I = "         BNE   RETURN"
   I=I+1; A.I = "         SR    3,3"
   I=I+1; A.I = "RETURN   LR    15,3"
   I=I+1; A.I = "         LM    0,14,SAVE"
   I=I+1; A.I = "         BR    14"
   I=I+1; A.I = "PSW      DC    D'0'"
   I=I+1; A.I = "SAVE     DS    16F"
   If HasHRC100DS then Do
      I=I+1; A.I = "AEXEC    EQU   X'690'"
   End
   Else Do
      I=I+1; A.I = "NUCPLUEX EQU   X'FF8'"
   End
   I=I+1; A.I = "         END"
   A.0 = I
   Call Assemble 'A.', 'TEXBD'
   E.1 = "/* TEXBD EXEC */"
   E.2 = "Say Arg(1) 'from TEXBD!'"
   E.3 = "Exit 92"
   E.0 = 3
   'EXECIO' E.0 'DISKW TEXBD EXEC A (FINIS STEM E.'
   'WITHSTEM OUTPUT OUT. COMMAND LOAD TEXBD ( START'
   Ref.1 = 'DMSLIO740I Execution begins...'
   Ref.2 = 'Hi Mom! from TEXBD!'
   Ref.0 = 2
   Call Erase 'TEXBD * A'
   Call AssertStemIdentical 'Ref.', 'Out.'
   Return

TestExecBalrStorage:
   Call Erase 'TEXBS * A'
   I=0
   I=I+1; A.I = "TEXBS    START X'20000'"
   I=I+1; A.I = "         BALR  11,0"
   I=I+1; A.I = "         USING *,11"
   I=I+1; A.I = "         STM   0,15,SAVE"
   I=I+1; A.I = "         CNOP  0,4"
   I=I+1; A.I = "         BAL   1,DOIT"
   I=I+1; A.I = "CMD      DC    CL8'EXEC'"
   I=I+1; A.I = "ARGS     DC    CL8'TEXBS'"
   I=I+1; A.I = "         DC    CL8'Hi'"
   I=I+1; A.I = "         DC    CL8'Mom!'"
   I=I+1; A.I = "ARGE     DC    8X'FF'"
   I=I+1; A.I = "DOIT     DS    0H"
   I=I+1; A.I = "         LA    2,CMD"
   I=I+1; A.I = "         ST    2,EPCMD"
   I=I+1; A.I = "         LA    2,ARGS"
   I=I+1; A.I = "         ST    2,EPARGS"
   I=I+1; A.I = "         LA    2,ARGE"
   I=I+1; A.I = "         ST    2,EPARGE"
   I=I+1; A.I = "         XC    EPFBLK,EPFBLK"
   I=I+1; A.I = "         ICM   1,B'1000',=X'01'"
   I=I+1; A.I = "         LA    0,EPCMD"
   If HasHRC100DS then Do
      I=I+1; A.I = "         L     12,AEXEC(,0)"
   End
   Else Do
      I=I+1; A.I = "         MVC   PSW(2),=X'FFE0'"
      I=I+1; A.I = "         L     12,NUCPLUEX(,0)"
   End
   I=I+1; A.I = "         ST    12,PSW+4"
   I=I+1; A.I = "         LR    15,12"
   I=I+1; A.I = "         LA    14,EXECRET"
   I=I+1; A.I = "         LPSW  PSW"
   I=I+1; A.I = "EXECRET  BALR  11,0"
   I=I+1; A.I = "         USING *,11"
   I=I+1; A.I = "         LA    3,901"
   I=I+1; A.I = "         C     15,=F'96'"
   I=I+1; A.I = "         BNE   RETURN"
   I=I+1; A.I = "         SR    3,3"
   I=I+1; A.I = "RETURN   LR    15,3"
   I=I+1; A.I = "         LM    0,14,SAVE"
   I=I+1; A.I = "         BR    14"
   I=I+1; A.I = "         DS    0D"
   I=I+1; A.I = "PSW      DC    D'0'"
   I=I+1; A.I = "SAVE     DS    16F"
   I=I+1; A.I = "EPCMD    DS    A"
   I=I+1; A.I = "EPARGS   DS    A"
   I=I+1; A.I = "EPARGE   DS    A"
   I=I+1; A.I = "EPFBLK   DS    A"
   If HasHRC100DS then Do
      I=I+1; A.I = "AEXEC    EQU   X'690'"
   End
   Else Do
      I=I+1; A.I = "NUCPLUEX EQU   X'FF8'"
   End
   I=I+1; A.I = "         END"
   A.0 = I
   Call Assemble 'A.', 'TEXBS'
   E.1 = "/* TEXBS EXEC */"
   E.2 = "Say Arg(1) 'from TEXBS!'"
   E.3 = "Exit 96"
   E.0 = 3
   'EXECIO' E.0 'DISKW TEXBS EXEC A (FINIS STEM E.'
   'EXECLOAD TEXBS EXEC'
   Call Erase 'TEXBS EXEC A'
   'EXECSTAT TEXBS EXEC'
   'WITHSTEM OUTPUT OUT. COMMAND LOAD TEXBS ( START'
   Ref.1 = 'DMSLIO740I Execution begins...'
   Ref.2 = 'Hi Mom! from TEXBS!'
   Ref.0 = 2
   Call Erase 'TEXBS * A'
   Call AssertStemIdentical 'Ref.', 'Out.'
   Return

TestExecDrop:
   Call Erase 'TEXD * A'
   E.1 = "/* TEXD EXEC */"
   E.2 = "Say 'Hi from TEXD!'"
   E.3 = "Exit 25"
   E.0 = 3
   'EXECIO' E.0 'DISKW TEXD EXEC A (FINIS STEM E.'
   'EXECLOAD TEXD EXEC'
   Call NoError 'EXECSTAT TEXD EXEC'
   Call AssertEqual 0, RC
   Call Erase 'TEXD * A'
   'EXECDROP TEXD EXEC'
   Call NoError 'EXECSTAT TEXD EXEC'
   Call AssertEqual 8, RC
   Return

TestExecLoad:
   Call Erase 'TEXL * A'
   E.1 = "/* TEXL EXEC */"
   E.2 = "Say 'Hi from TEXL!'"
   E.3 = "Exit 25"
   E.0 = 3
   'EXECIO' E.0 'DISKW TEXL EXEC A (FINIS STEM E.'
   'EXECLOAD TEXL EXEC'
   Call NoError 'EXECSTAT TEXL EXEC'
   $RC = RC
   'EXECDROP TEXL EXEC'
   Call Erase 'TEXL * A'
   Call AssertEqual 0, $RC
   Return

TestExecMap:
   Call Erase 'TEXM * A'
   E.1 = "/* TEXM EXEC */"
   E.2 = "Say 'Hi from TEXM!'"
   E.3 = "Exit 25"
   E.0 = 3
   ExpectedSize = (1*800) + (3*8) + (7*8)
   Call NoError 'EXECDROP * *'
   'EXECIO' E.0 'DISKW TEXM EXEC A (FINIS STEM E.'
   'EXECLOAD TEXM EXEC'
   R.1 = 'Name     Type     Usage    Records  Bytes'
   If HasHRC100DS then R.1 = R.1 || '    Attribute'
   R.2 = 'TEXM     EXEC            0        3' Right(ExpectedSize, 8)
   If HasHRC100DS then R.2 = R.2 || ' USER     '
   R.0 = 2
   'WITHSTEM OUTPUT O. COMMAND EXECMAP'
   'EXECDROP * *'
   Call Erase 'TEXM * A'
   Call AssertStemIdentical 'R.', 'O.'
   Return

TestExecStatNoFile:
   Call NoError 'EXECSTAT TEXSN EXEC'
   Call AssertEqual 8, RC
   Return

TestExecStatDisk:
   Call Erase 'TEXSD * A'
   E.1 = "/* TEXSD EXEC */"
   E.2 = "Say 'Hi from TEXSD!'"
   E.3 = "Exit 25"
   E.0 = 3
   'EXECIO' E.0 'DISKW TEXSD EXEC A (FINIS STEM E.'
   Call NoError 'EXECSTAT TEXSD EXEC'
   $RC = RC
   Call Erase 'TEXSD * A'
   Call AssertEqual 4, $RC
   Return

TestExecStatStorage:
   Call Erase 'TEXSS * A'
   E.1 = "/* TEXSS EXEC */"
   E.2 = "Say 'Hi from TEXSS!'"
   E.3 = "Exit 25"
   E.0 = 3
   'EXECIO' E.0 'DISKW TEXSS EXEC A (FINIS STEM E.'
   'EXECLOAD TEXSS EXEC'
   Call NoError 'EXECSTAT TEXSS EXEC'
   $RC = RC
   Call Erase 'TEXSS * A'
   Call AssertEqual 0, $RC
