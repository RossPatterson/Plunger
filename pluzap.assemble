ZAP      TITLE 'Configuration.'
         COPY  PLUCONFG
         ENTRY PLUZAPMD
PLUZAP   CSECT ,
         TITLE 'PLUZAPMD - ZAP the PIPELINE module.'
         PUSH  USING
         USING NUCON,0
PLUZAPMD $ENTER ,
         L     R10,NUCPLUPT
         USING PRMSECT,R10
         NI    WRKFLAG1,255-(WRKF1NGO+WRKF1ERX) Turn off "NO GO" flags.
         LA    R4,ZAPTBL1     -> Main ZAP table.
         BAL   R9,APPLY       Apply the main set of ZAPs.
         SPACE 3
         TM    PRMFLAG1,PRMF1EXS  Does CMS have EXIS support?
         BO    GOTEXIS        Yes, skip the EXIS ZAPs.
         LA    R4,ZAP007      -> EXIS-support ZAP.
         BAL   R9,APPLY       Apply the EXEC-in-storage set of ZAPs.
GOTEXIS  DS    0H
         SPACE 3
EXIT     DS    0H
         SR    R15,R15        Assume all is well.
         TM    WRKFLAG1,WRKF1ERX  Did at least one VER fail?
         BZ    *+8            No, guessed right.
         LA    R15,20         Yes, need to fail.
         $EXIT ,
         TITLE 'APPLY - Apply a set of ZAPs.'
APPLY    DS    0H
MAINLOOP DS    0H
         USING ZAPENT,R4
         ICM   R5,B'1111',ZAPOFF Get offset to location.
         SR    R6,R6          Get data
         IC    R6,ZAPDLEN        length.
         TM    PRMFLAG1,PRMF1DBG  Are we debugging?
         BZ    NODEBUG        No, skip message.
         AIF   (NOT &DEBUG).NXLD02
         LA    R8,1(,R6)
MSG015   LINEDIT TEXT='PLUZAP015I ZAP .. ...... .......................*
               ............',                                          *
               SUB=(DECA,ZAPTYPE,HEX,(R5),HEX4A,(ZAPDATA,(R8))),       *
               DISP=ERRMSG,DOT=NO,MF=(E,WRKLEDPL)
.NXLD02  ANOP  ,
NODEBUG  DS    0H
         SR    R1,R1          Get ZAP
         IC    R1,ZAPTYPE        verb type.
         C     R1,=A(ZAPTMAX)  Is it a legal value?
         BH    CARDBAD        No, how did THAT happen?
         B     *+4(R1)        Yes, go to handler:
         B     CARDEND        END
         B     CARDREPN       REP RELOC=NONE
         B     CARDREPO       REP RELOC=OFFSET
         B     CARDREPJ       REP RELOC=PIPMOD
         B     CARDREPR       REP RELOC=PLUNGER
         B     CARDRSET       RESET
         B     CARDVERN       VER RELOC=NONE
         B     CARDVERJ       VER RELOC=PIPMOD
         SPACE 3
CARDBAD  DS    0H
         BAL   R14,MSG027     "Illegal ZAP line at <addr>: <data>"
         B     NEXTCARD       Go process next entry.
         SPACE 3
CARDRSET DS    0H
         NI    WRKFLAG1,255-WRKF1NGO  Turn off "NO GO" flag.
         SH    R6,=H'1'       Fix length.
         B     NEXTCARD       Go process next entry.
         SPACE 3
CARDREPJ DS    0H
         TM    WRKFLAG1,WRKF1NGO  Is the "NO GO" flag on?
         BO    ERRNOGO        Yes, don't do it.
         C     R6,=F'3'       Length=4?
         BNE   CARDBAD        No, how did THAT happen?
         ICM   R1,B'1111',ZAPDATA  Yes, get the data
         S     R1,=A(X'20000')   - PIPMOD base address
         A     R1,PRMPIPMD          + PIPMOD address in memory.
         A     R5,PRMPIPMD    Convert offset to address.
         STCM  R1,B'1111',0(R5)  Replace target with relocated data.
         B     NEXTCARD       Go process next entry.
         SPACE 3
CARDREPN DS    0H
         TM    WRKFLAG1,WRKF1NGO  Is the "NO GO" flag on?
         BO    ERRNOGO        Yes, don't do it.
         A     R5,PRMPIPMD    Convert offset to address.
         MVC   0(*-*,R5),ZAPDATA *** EXecuted ***
         EX    R6,*-6         Replace the target with ZAP data.
         B     NEXTCARD       Go process next entry.
         SPACE 3
CARDREPO DS    0H
*
* RELOC=OFFSET: final value is DATA - DATA_LOCATION ("DC A(XXX-*)").
*
         C     R6,=F'3'       Length=4?
         BNE   CARDBAD        No, how did THAT happen?
         ICM   R1,B'1111',ZAPDATA  Yes, get the data
         S     R1,=A(X'20000')   - PLUNGER base address
         A     R1,PRMPLUNG          + PLUNGER address in memory.
         A     R5,PRMPIPMD    Convert offset to address.
         SR    R1,R5          Relative to target location.
         STCM  R1,B'1111',0(R5)  Replace target with relocated data.
         B     NEXTCARD       Go process next entry.
         SPACE 3
CARDREPR DS    0H
         C     R6,=F'3'       Length=4?
         BNE   CARDBAD        No, how did THAT happen?
         ICM   R1,B'1111',ZAPDATA  Yes, get the data
         S     R1,=A(X'20000')   - PLUNGER base address
         A     R1,PRMPLUNG          + PLUNGER address in memory.
         A     R5,PRMPIPMD    Convert offset to address.
         STCM  R1,B'1111',0(R5)  Replace target with relocated data.
         B     NEXTCARD       Go process next entry.
         SPACE 3
CARDVERN DS    0H
         A     R5,PRMPIPMD    Convert offset to address.
         CLC   0(*-*,R5),ZAPDATA *** EXecuted ***
         EX    R6,*-6         Does the data match?
         BE    NEXTCARD       Yes, go process next entry.
         B     CARDVERF       No, go fail the ZAP.
         SPACE 3
CARDVERJ DS    0H
         C     R6,=F'3'       Length=4?
         BNE   CARDBAD        No, how did THAT happen?
         ICM   R1,B'1111',ZAPDATA  Yes, get the data
         S     R1,=A(X'20000')   - PIPMOD base address
         A     R1,PRMPIPMD          + PIPMOD address in memory.
         A     R5,PRMPIPMD    Convert offset to address.
         CLM   R1,B'1111',0(R5)  Does the relocated data match?
         BE    NEXTCARD       Yes, go process next entry.
         SPACE 3
CARDVERF DS    0H
         BAL   R14,MSG016     "VER failed: <addr> <data>"
         TM    WRKFLAG1,WRKF1NGO  Flag already set?
         BO    NEXTCARD       Yes, go process next entry.
         OI    WRKFLAG1,WRKF1NGO  No, turn on "NO GO" flag
         OI    WRKFLAG1,WRKF1ERX     and fail.
         BAL   R14,MSG017     "NOGO flag is now set"
         B     NEXTCARD       Go process next entry.
         SPACE 3
ERRNOGO  BAL   R14,MSG018     "NOGO flag is set, REP ignored"
NEXTCARD LA    R4,ZAPDATA+1(R6) -> next patch.
         B     MAINLOOP       Next!
CARDEND  DS    0H
*        WAITT ,              Let all the ZAP output get to console.
         LA    1,=CL8'CONWAIT'  Because
         SVC   202               WAITT doesn't
         DC    AL4(1)               have ERROR=.
         SPACE 3
         BR    R9
         DROP  R4
         TITLE 'Messages.'
MSG002   DS    0H             No WRKSECT on this one, so no MF=E.
         LINEDIT TEXT='PLUZAP002E Cannot obtain workarea',DISP=ERRMSG
         LA    R15,2
         BR    R14
         SPACE 3
MSG016   DS    0H
         USING ZAPENT,R4
         LA    R2,1(,R6)      Bump up from EX len.
         LINEDIT TEXT='PLUZAP016E VER failed: ........ expected .......*
               ............................, found ....................*
               ...............',                                       *
               SUB=(HEXA,ZAPOFF,HEX4A,(ZAPDATA,(R2)),                  *
               HEX4A,((R5),(R2))),                                     *
               DISP=ERRMSG,                                            *
               MF=(E,WRKLEDPL)
         DROP  R4
         LA    R15,16
         BR    R14
         SPACE 3
MSG017   DS    0H
         LINEDIT TEXT='PLUZAP017E NOGO flag is now set',               *
               DISP=ERRMSG
         LA    R15,17
         BR    R14
         SPACE 3
MSG018   DS    0H
         LINEDIT TEXT='PLUZAP018E NOGO flag is set, REP ignored',      *
               DISP=ERRMSG,                                            *
               MF=(E,WRKLEDPL)
         LA    R15,18
         BR    R14
         SPACE 3
MSG027   DS    0H
         LINEDIT TEXT='PLUZAP027E Illegal ZAP line at ........: .......*
               ......................................................',*
               SUB=(HEX4A,(R4),HEXA,(R4)),                             *
               DISP=ERRMSG,RENT=NO,                                    *
               MF=(E,WRKLEDPL)
         B     MSG017         Set NOGO flag.
         POP   USING
         TITLE 'Main ZAPs to always apply to PIPELINE.'
ZAPTBL1  DS    0D
         EJECT ,
ZAP001   DS    0X
*
*        Update HRC415DS moved the CMS nucleus to high memory, but
*        but didn't set NUCALPHA, NUCSIGMA, and NUCOMEGA, so Pipelines
*        thinks DMSCWR (WRTERM) isn't where should be.  Pipelines
*        doesn't change any behavior, it just issues the message.
*        Since we can't control where DMSCWR is located, we suppress
*        the message instead.
*
         $ZAP  VER,248E6,12EE             LTR   R14,R14
         $ZAP  VER,248E8,4780C164         BZ    X'164'(,R12)
         $ZAP  REP,248E8,47F0C164         B     X'164'(,R12)
         $ZAP  RESET
         EJECT ,
ZAP003   DS    0X
*
*        PIPELINE tests NUCMFLAG in several places to determine what
*        sort of CMS it is running in.  But that  byte was originally
*        DCSSFLG in VM/370, until it was turned into a spare byte in
*        VM/SP, and later re-used.  So the check is wrong.  This ZAP
*        takes over a different spare byte, NUCCFA, and lets PIPELINE
*        set either NUCMEC or NUCM370 in it, depending on whether CMS
*        is running in EC mode or not, and then test that everywhere.
*
         $ZAP  VER,0856E,91A605EA         TM    NUCMFLAG,NUCMXA+...
         $ZAP  REP,0856E,91A60CFA         TM    NUCCFA,NUCMXA+...
         $ZAP  VER,085A4,960205EA         OI    NUCMFLAG,NUCM370
         $ZAP  REP,085A4,96020CFA         OI    NUCCFA,NUCM370
         $ZAP  VER,085AC,962005EA         OI    NUCMFLAG,NUCMEC
         $ZAP  REP,085AC,96200CFA         OI    NUCCFA,NUCMEC
         $ZAP  VER,2464E,910205EA         TM    NUCMFLAG,NUCM370
         $ZAP  REP,2464E,91020CFA         TM    NUCCFA,NUCM370
         $ZAP  VER,24664,912205EA         TM   NUCMFLAG,NUCMEC+NUCM370
         $ZAP  REP,24664,91220CFA         TM    NUCCFA,NUCMEC+NUCM370
         $ZAP  VER,24906,914005EA         TM    NUCMFLAG,NUCMA4A8
         $ZAP  REP,24906,91400CFA         TM    NUCCFA,NUCMA4A8
         $ZAP  VER,24912,912005EA         TM    NUCMFLAG,NUCMEC
         $ZAP  REP,24912,91200CFA         TM    NUCCFA,NUCMEC
         $ZAP  VER,26D1E,910405EA         TM    NUCMFLAG,NUCMXC
         $ZAP  REP,26D1E,91040CFA         TM    NUCCFA,NUCMXC
         $ZAP  VER,2B370,41F005EA         LA    R15,NUCMFLAG
         $ZAP  REP,2B370,41F00CFA         LA    R15,NUCCFA
         $ZAP  VER,2B39E,411005EA         LA    R1,NUCMFLAG
         $ZAP  REP,2B39E,41100CFA         LA    R1,NUCCFA
         $ZAP  VER,3DD62,918005EA         TM    NUCMFLAG,NUCMXA
         $ZAP  REP,3DD62,91800CFA         TM    NUCCFA,NUCMXA
         $ZAP  VER,672E0,910405EA         TM    NUCMFLAG,NUCMXC
         $ZAP  REP,672E0,91040CFA         TM    NUCCFA,NUCMXC
         $ZAP  VER,673AE,91A405EA         TM    NUCMFLAG,NUCMXA+...
         $ZAP  REP,673AE,91A40CFA         TM    NUCCFA,NUCMXA+...
         $ZAP  VER,673BA,912005EA         TM    NUCMFLAG,NUCMEC
         $ZAP  REP,673BA,91200CFA         TM    NUCCFA,NUCMEC
         $ZAP  VER,7753A,918005EA         TM    NUCMFLAG,NUCMXA
         $ZAP  REP,7753A,91800CFA         TM    NUCCFA,NUCMXA
         $ZAP  VER,99DA4,918005EA         TM    NUCMFLAG,NUCMXA
         $ZAP  REP,99DA4,91800CFA         TM    NUCCFA,NUCMXA
         $ZAP  RESET
         EJECT ,
ZAP004   DS    0X
*
*        DIAG 0 in VM/370 doesn't set the "VM/SP" bit, so PIPELINE
*        thinks we're running VM/XA mode.  So patch the DIAG to
*        call S199DI00 instead, where we'll set it.
*
         $ZAP  VER,865C,41E0A130          LA    R14,304(,R10)
         $ZAP  VER,8660,41F00028          LA    R15,40
         $ZAP  VER,8664,83EF0000          DIAG  R14,R15,X'0000'
         $ZAP  REP,8664,0AC7              SVC   199
         $ZAP  REP,8666,0000              DC    H'0'
         $ZAP  RESET
         EJECT ,
ZAP005   DS    0X
*
*        PIPELINE uses a newer version of FVS than VM/370's, and gets
*        STATER0 from the wrong place.
*
         $ZAP  VER,E2B0,58500600          L    R5,AFVS
         $ZAP  VER,E2B4,58805220          L    R8,STATER0   @ X'220'
         $ZAP  REP,E2B4,58805200          L    R8,STATER0   @ X'200'
         $ZAP  RESET
         EJECT ,
ZAP006   DS    0X
*
*        PIPELINE calls RENAME (NOUPDIR, but VM/370 R6 expects
*        (NOUPDIRT.
*
         $ZAP  VER,DA58,D9C5D5C1D4C54040  DC   CL8'RENAME  '
         $ZAP  VER,DA80,D5D6E4D7C4C9D940  DC   CL8'NOUPDIR '
         $ZAP  REP,DA80,D5D6E4D7C4C9D9E3  DC   CL8'NOUPDIRT'
         $ZAP  RESET
         EJECT ,
ZAP008   DS    0X
*
*        The CMS and COMMAND stages seem to be written for CMS5.5 and
*        later.  We've implemented everything it needs, so we force it
*        down the CMS5.5 code path.
*
         $ZAP  VER,75F2E,9106B0C4         TM    X'0C4'(R11),X'06'
         $ZAP  VER,75F32,4770C014         BNZ   X'014'(,R12)
         $ZAP  VER,75F36,000001C8         DC    H'0'X'01C8'
         $ZAP  REP,75F32,47F0C014         B     X'014'(,R12)
         $ZAP  RESET
         EJECT ,
ZAP009   DS    0H
*
*        Pipelines occasionally crashes with a PROG 0009 (divide-by-0)
*        exception, and crashes CMS as a result.  It appears that this
*        results from code trying to handle EDF disks, which CMS370
*        does not support.  This ZAP forces the "<", ">", ">>",
*        "<MDSK", ">MDSK", and ">>MDSK" device drivers to be handled
*        as "MDSKSLOW", using the FS* macro functions.  Pipelines has
*        a facility to this via an FST bit, but it doesn't seem to
*        solve 100% of the cases (ref. GitHub Issue #9).
*
*        To make matters worse, ">" and ">MDSK" are supposed to replace
*        the output file, but "MDSKSLOW" can only append to it.  So we
*        have to trap ">" and ">MDSK" and send them to our code in
*        PLUFNCMS to ERASE the file before then continuing on to
*        "MDSKSLOW".
*
         EXTRN PLUFNCMS
         $ZAP  VER,5828,D4C4E2D2E2D3D6E6        DC    CL8'MDSKSLOW'
         $ZAP  VER,5834,0002CA20,RELOC=PIPMOD   DC    A(FPLDSKSL)
         $ZAP  REP,CA30,PLUFNCMS,RELOC=OFFSET   DC    V(PLUFNCMS)
*
         $ZAP  VER,45A8,4C40404040404040        DC    CL8'<       '
         $ZAP  VER,45B4,0008BC18,RELOC=PIPMOD   DC    A(FPLDSCRO)
         $ZAP  REP,45B4,0002CA20,RELOC=PIPMOD   DC    A(FPLDSKSL)
*
         $ZAP  VER,45B8,4CD4C4E2D2404040        DC    CL8'<MDSK   '
         $ZAP  VER,45C4,0002CA80,RELOC=PIPMOD   DC    A(FPLDSKRO)
         $ZAP  REP,45C4,0002CA20,RELOC=PIPMOD   DC    A(FPLDSKSL)
*
         $ZAP  VER,4608,6E40404040404040        DC    CL8'>       '
         $ZAP  VER,4614,0008BCA8,RELOC=PIPMOD   DC    A(FPLDSCWE)
         $ZAP  REP,4614,0002CA20,RELOC=PIPMOD   DC    A(FPLDSKSL)
*
         $ZAP  VER,4618,6E6E404040404040        DC    CL8'>>      '
         $ZAP  VER,4624,0008BC60,RELOC=PIPMOD   DC    A(FPLDSCWO)
         $ZAP  REP,4624,0002CA20,RELOC=PIPMOD   DC    A(FPLDSKSL)
*
         $ZAP  VER,4628,6E6ED4C4E2D24040        DC    CL8'>>MDSK  '
         $ZAP  VER,4634,0002CAE8,RELOC=PIPMOD   DC    A(FPLDSKWO)
         $ZAP  REP,4634,0002CA20,RELOC=PIPMOD   DC    A(FPLDSKSL)
*
         $ZAP  VER,4678,6ED4C4E2D2404040        DC    CL8'>MDSK   '
         $ZAP  VER,4684,0002CB40,RELOC=PIPMOD   DC    A(FPLDSKWE)
         $ZAP  REP,4684,0002CA20,RELOC=PIPMOD   DC    A(FPLDSKSL)
         $ZAP  RESET
         EJECT ,
ZAP010   DS    0X
*
*        The NUCEXT stage has what appears to be a genuine Pipelines
*        bug.  If the nucleus extension is not found in its original
*        case (e.g., "tNx"), the code that searches for the upcased
*        version will PROG 0004, because the routine that did the
*        first search destroyed the second search's input register.
*        This does not happen if the first search succeeds, or if
*        Pipelines decides to search via SVC 204 instead of 202.
*
         $ZAP  VER,14DEE,58F090CC         L     R15,X'0CC'(,R9)
         $ZAP  REP,14DEE,0AC7             SVC   199  Go fix
         $ZAP  REP,14DF0,0001             DC    H'1'    R1.
         $ZAP  RESET
         EJECT ,
ZAP011   DS    0X
*
*        The SPECS stage sometimes, especially in smaller virtual
*        machines, calls a routine in FPLSPS called LOADSPAC, which
*        then aborts with FPLINX409E Assert failure 00000182. It's
*        just a guess, but from "FPLSPS" and "LOADSPAC", I'm guessing
*        this is an attempt to use a dataspace, which of course,
*        VM/370 CMS doesn't have.
*
*        This code in FPLSPERN only calls that routine for one
*        condition.  It isn't clear what is really going on, but
*        but ignoring that condition always seems to work.
*
         $ZAP  VER,CBB92,9506B133         CLI   X'133'(R11),6
         $ZAP  VER,CBB96,4770C42E         BNE   X'42E'(,R12)
         $ZAP  VER,CBB9A,4170B120         LA    R7,X'120'(,R11)
         $ZAP  VER,CBB9E,58F0C47E         L     R15,X'47E'(,R12)
         $ZAP  VER,CBBA2,0DEF             BASR  R14,R15
         $ZAP  REP,CBB96,47F0             B     X'42E'(,R12)
         EJECT ,
         $ZAP  END
         TITLE 'EXIS ZAP to apply if HRC100DS is not installed.'
ZAP007   DS    0X
*
*        PIPELINE calls EXEC via BALR to run Rexx stages.  Make it
*        call bREXX directly, because DMSEXC doesn't know about
*        in-storage EXECs.
*
         $ZAP  VER,99B8A,58F00690         L    R15,AEXEC
         $ZAP  REP,99B8A,58F00FF8         L    R15,NUCPLUEX
         $ZAP  VER,99F1E,58F00690         L    R15,AEXEC
         $ZAP  REP,99F1E,58F00FF8         L    R15,NUCPLUEX
         $ZAP  VER,99F48,58F00690         L    R15,AEXEC
         $ZAP  REP,99F48,58F00FF8         L    R15,NUCPLUEX
         $ZAP  RESET
         EJECT ,
         $ZAP  END
         LTORG ,
         TITLE 'ZAP details.'
ZAPENT   DSECT ,
ZAPOFF   DS    AL4            Offset to code location.
ZAPTYPE  DS    X              Entry type.
ZAPTEND  EQU   0              - END
ZAPTREPN EQU   4              - REP RELOC=NONE
ZAPTREPO EQU   8              - REP RELOC=OFFSET
ZAPTREPJ EQU   12             - REP RELOC=PIPMOD
ZAPTREPR EQU   16             - REP RELOC=PLUNGER
ZAPTRES  EQU   20             - RESET
ZAPTVERN EQU   24             - VER RELOC=NONE
*ZAPTVERO                     - VER RELOC=OFFSET - unused
ZAPTVERJ EQU   28             - VER RELOC=PIPMOD
*ZAPTVERR                     - VER RELOC=PLUNGER - unused
ZAPTMAX  EQU   28             Highest value of ZAPTYPE
ZAPDLEN  DS    AL1            Data length.
ZAPDATA  DS    0X             Start of ZAP data.
         TITLE 'Working storage.'
WRKSECT  DSECT ,
WRKSAVE  DS    18F            Save area (must be first in DSECT).
WRKLEND  DS    F              Size of this WRKSECT in doublewords.
WRKFLAG1 DS    X              Flags
WRKF1NGO EQU   X'80'          - ZAP "VER" failed.
WRKF1ERX EQU   X'40'          - Need to fail PLUZAPMD.
         SPACE 1
WRKPLST1 DS    0D             Assorted plists, sharing space.
WRKLEDPL LINEDIT MF=L,MAXSUBS=3  LINEDIT plist.
         ORG   ,
WRKPLSTS EQU   WRKPLST1,*-WRKPLST1
WRKDATA  DS    0D             Start of variable data area.
WRKLEN   EQU   *-WRKSECT
         TITLE 'DSECTs.'
         NUCON ,
         ORG   NUCON+X'CFA'
NUCCFA   DS    X              Machine-type flags (relocated).
         ORG   NUCON+X'FFC'
NUCPLUPT DS    A              -> PLUNGER PRMSECT.
         ORG   ,
         EJECT ,
         PLUPRM ,
         REGEQU ,
         SCBLOCK ,
         END   ,
